const ALIEN_SCREAM_GAIN = .7; // master level for every alien scream
function playAlienScream(rate = 1, volume = .9) {
  try {
    const s = alienScreamSfx.cloneNode();
    s.playbackRate = rate;
    s.preservesPitch = false;
    s.volume = Math.min(1, volume * ALIEN_SCREAM_GAIN);
    s.play().catch(() => {});
  } catch (err) {
    playSfx("squish");
  }
}
