function hasItem(id) {
  return state.inventory.includes(id);
}

function addItem(id) {
  if (!hasItem(id)) state.inventory.push(id);
  state.selected = id;
  popComic("yoink!", state.player.x + 18, state.player.y - 76, "#f2c45b");
  setLog(`${items[id].name} added to inventory.`);
  updateUI();
}

function removeItem(id) {
  state.inventory = state.inventory.filter(item => item !== id);
  if (state.selected === id) state.selected = null;
}

function setLog(text) {
  if (ui.log) ui.log.textContent = text;
}

function toast(text) {
  clearTimeout(toastTimer);
  ui.toast.textContent = text;
  ui.toast.hidden = false;
  toastTimer = setTimeout(() => ui.toast.hidden = true, 1800);
}

function getAudioContext() {
  const AudioCtor = window.AudioContext || window.webkitAudioContext;
  if (!AudioCtor) return null;
  if (!audioContext) audioContext = new AudioCtor();
  if (audioContext.state === "suspended") audioContext.resume();
  return audioContext;
}

function playTone(frequency, duration = .12, type = "sine", gain = .06, delay = 0, slideTo = null) {
  const audio = getAudioContext();
  if (!audio) return;
  const when = audio.currentTime + delay;
  const osc = audio.createOscillator();
  const amp = audio.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(frequency, when);
  if (slideTo) osc.frequency.exponentialRampToValueAtTime(Math.max(20, slideTo), when + duration);
  amp.gain.setValueAtTime(0.0001, when);
  amp.gain.exponentialRampToValueAtTime(gain, when + .015);
  amp.gain.exponentialRampToValueAtTime(0.0001, when + duration);
  osc.connect(amp).connect(audio.destination);
  osc.start(when);
  osc.stop(when + duration + .03);
}

function playNoise(duration = .18, gain = .05, delay = 0, filterFrequency = 1200) {
  const audio = getAudioContext();
  if (!audio) return;
  const when = audio.currentTime + delay;
  const buffer = audio.createBuffer(1, Math.max(1, Math.floor(audio.sampleRate * duration)), audio.sampleRate);
  const data = buffer.getChannelData(0);
  for (let i = 0; i < data.length; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / data.length);
  const source = audio.createBufferSource();
  const filter = audio.createBiquadFilter();
  const amp = audio.createGain();
  source.buffer = buffer;
  filter.type = "bandpass";
  filter.frequency.value = filterFrequency;
  filter.Q.value = .9;
  amp.gain.setValueAtTime(gain, when);
  amp.gain.exponentialRampToValueAtTime(0.0001, when + duration);
  source.connect(filter).connect(amp).connect(audio.destination);
  source.start(when);
  source.stop(when + duration + .03);
}

function soundKind(label) {
  return String(label).toLowerCase().replace(/[^a-z]/g, "");
}

function playSfx(label) {
  const kind = soundKind(label);
  if (kind === "nope") {
    playTone(180, .13, "square", .045, 0, 120);
    playTone(105, .16, "sawtooth", .035, .08, 80);
  } else if (kind === "clank") {
    playTone(145, .08, "triangle", .06);
    playTone(92, .11, "square", .035, .045);
    playNoise(.08, .045, 0, 3600);
  } else if (kind === "squish") {
    playTone(220, .18, "sine", .05, 0, 90);
    playNoise(.14, .035, .02, 420);
  } else if (kind === "psshh") {
    playNoise(.42, .055, 0, 2600);
    playNoise(.28, .025, .12, 5200);
  } else if (kind === "ding") {
    playTone(784, .18, "sine", .045);
    playTone(1175, .24, "sine", .025, .08);
  } else if (kind === "boop") {
    playTone(320, .09, "sine", .045, 0, 540);
  } else if (kind === "kzzt") {
    playNoise(.2, .055, 0, 4700);
    playTone(75, .08, "sawtooth", .025);
  } else if (kind === "pop" || kind === "yoink") {
    playTone(kind === "yoink" ? 520 : 360, .08, "triangle", .045, 0, kind === "yoink" ? 960 : 620);
  } else if (kind === "whoomp") {
    playTone(92, .22, "sine", .055, 0, 55);
    playNoise(.18, .025, .02, 300);
  } else if (kind === "whoosh") {
    playNoise(.28, .045, 0, 1800);
    playTone(260, .16, "sine", .025, 0, 520);
  } else if (kind === "water") {
    playNoise(.34, .032, 0, 1850);
    playNoise(.2, .018, .08, 3600);
    playTone(720, .08, "sine", .012, .04, 980);
  }
}

function playCoughSfx(beat) {
  // A bright consonant burst followed by a breathy throat release reads as a
  // cough. Avoid pitched low tones here; they sound like tool impacts.
  const second = beat === 2;
  playNoise(.052, second ? .045 : .052, 0, second ? 2350 : 2100);
  playNoise(second ? .125 : .145, second ? .048 : .055, .026, second ? 900 : 760);
  playNoise(second ? .07 : .085, second ? .024 : .029, .082, second ? 1550 : 1380);
}

function playGruntSfx() {
  // A short low vocal-like push layered with breath, timed to the deepest
  // reaching frame. Keep it compact so it reads as effort rather than speech.
  playTone(118, .24, "sawtooth", .032, 0, 82);
  playNoise(.19, .026, .018, 680);
}

const NOPE_REACTION_MS = 950;
const DISGUST_REACTION_MS = 1320;

function playerIsReacting() {
  return performance.now() < state.reactionUntil;
}

function reactNope() {
  state.reactionKind = "nope";
  state.reactionUntil = performance.now() + NOPE_REACTION_MS;
  playSfx("NOPE!");
}

function reactDisgust() {
  state.reactionKind = "disgust";
  state.reactionUntil = performance.now() + DISGUST_REACTION_MS;
}

function popComic(text, x, y, color = "#fff3c5") {
  playSfx(text);
}

function playCombineTwinkle() {
  combineTwinkleSfx.pause();
  combineTwinkleSfx.currentTime = 0;
  combineTwinkleSfx.volume = .72;
  combineTwinkleSfx.play().catch(() => {});
}

function playHallwayTone(tone) {
  const tones = {
    low: { frequency: 293.66, id: "hallToneLeft" },
    middle: { frequency: 440, id: "hallToneMiddle" },
    high: { frequency: 659.25, id: "hallToneRight" }
  };
  const note = tones[tone];
  if (!note) return;
  state.player.facing = "up";
  state.hallwayTonePulse = note.id;
  state.hallwayTonePulseUntil = performance.now() + 820;
  playTone(note.frequency, .64, "sine", .055);
  playTone(note.frequency * 2, .46, "triangle", .016, .025);
  registerHallwayDoorTone(tone);
}

const HALLWAY_DOOR_TONE_CODE = ["low", "low", "high", "middle"];

function registerHallwayDoorTone(tone) {
  if (!state.utilityCableRouted || state.hallDoorAOpen) return;
  const expected = HALLWAY_DOOR_TONE_CODE[state.hallwayDoorToneProgress];
  if (tone === expected) {
    state.hallwayDoorToneProgress += 1;
  } else {
    // A wrong note clears the attempt, but a low tone can immediately begin a
    // fresh sequence because the valid code itself starts on the left.
    state.hallwayDoorToneProgress = tone === HALLWAY_DOOR_TONE_CODE[0] ? 1 : 0;
    playSfx("kzzt");
  }
  if (state.hallwayDoorToneProgress < HALLWAY_DOOR_TONE_CODE.length) return;
  state.hallwayDoorToneProgress = 0;
  state.hallDoorAOpen = true;
  state.hallDoorAOpenStart = performance.now();
  playCombineTwinkle();
  setLog("The repeated tones wake the battered crew door. It retracts into the wall.");
}

function tryCombine(a, b) {
  const pair = [a, b].sort().join("+");
  if (pair === "helmet+sealant") {
    removeItem("helmet");
    removeItem("sealant");
    state.inventory.push("patchedHelmet");
    state.selected = "patchedHelmet";
    playCombineTwinkle();
    setLog("You press the sealant over the helmet crack. It wriggles once, then hardens into a perfect airlock plug.");
    updateUI();
    return true;
  }
  if (pair === "coldGoo+rod") {
    reactNope();
    setLog("The goo just slides off the smooth rod. Something needs to grip it.");
    return false;
  }
  if (pair === "hotGooClamp+rod") {
    removeItem("hotGooClamp");
    removeItem("rod");
    state.inventory.push("stickyPole");
    state.selected = "stickyPole";
    playCombineTwinkle();
    setLog("You lock the hot goo clamp onto the end of the rod. Now it reaches all the way across.");
    updateUI();
    return true;
  }
  if (pair === "coldGoo+specimenPole") {
    removeItem("coldGoo");
    removeItem("specimenPole");
    state.inventory.push("coldGooPole");
    state.selected = "coldGooPole";
    playCombineTwinkle();
    setLog("You grip a lump of cold goo in the sample clamp.");
    updateUI();
    return true;
  }
  if (pair === "heatedGoo+specimenPole") {
    removeItem("heatedGoo");
    removeItem("specimenPole");
    state.inventory.push("stickyPole");
    state.selected = "stickyPole";
    playCombineTwinkle();
    setLog("You coat the specimen pole in warm adhesive goo. It should stick to the far side of the broken walkway.");
    updateUI();
    return true;
  }
  reactNope();
  setLog(`${items[a].name} and ${items[b].name} do not seem useful together.`);
  return false;
}

function useSelectedOn(target) {
  const selected = state.selected;
  if (!selected) return false;

  if (target === "vent" && selected === "patchedHelmet" && !state.ventSealed) {
    if (!state.onLadder) {
      const floor = ladderFloorPoint();
      reactNope();
      state.player.tx = floor.x;
      state.player.ty = floor.y;
      setLog("The pressure leak is too high to reach from the floor.");
      return true;
    }
    removeItem("patchedHelmet");
    state.ventSealed = true;
    state.selected = null;
    popComic("PSSSHH!", 610, 130, "#7cf5de");
    setLog("You wedge the patched helmet into the vent. The screaming leak drops to a nervous hiss, then silence.");
    updateUI();
    return true;
  }

  if (target === "vent" && selected === "helmet") {
    if (!state.onLadder) {
      const floor = ladderFloorPoint();
      reactNope();
      state.player.tx = floor.x;
      state.player.ty = floor.y;
      setLog("The pressure leak is too high to reach from the floor.");
      return true;
    }
    reactNope();
    setLog("The helmet covers the leak, but air keeps screaming through the crack. It needs a sealant patch first.");
    return true;
  }

  if (target === "scanner" && selected === "tag" && state.pressureEqualized && !state.scannerSpoofed) {
    state.scannerSpoofed = true;
    state.selected = null;
    popComic("ding!", 716, 244, "#6df2d6");
    setLog("The scanner chirps at the maintenance tag, thinks very hard, and decides you are probably authorized machinery.");
    updateUI();
    return true;
  }

  if (target === "scanner" && selected === "tag") {
    reactNope();
    setLog("The tag sparks weakly, but the scanner will not wake until the airlock pressure is stable.");
    return true;
  }

  if (target === "utilityDoorButton" && selected === "wrench" && state.room === "utility") {
    state.utilityDoorPanelOpen = true;
    state.selected = null;
    state.player.facing = "up";
    playCombineTwinkle();
    setLog("The wrench pops the blue door panel loose. Something inside is waiting for a pull.");
    updateUI();
    return true;
  }

  if (target === "utilityDoorButton" && state.room === "utility") {
    reactNope();
    setLog("The blue panel is screwed shut. It needs a tool before it can help.");
    return true;
  }

  if (target === "utilityWire" && selected === "hose" && state.room === "utility") {
    if (!state.utilityDoorPanelOpen) {
      reactNope();
      setLog("The hose gives you a better grip, but there is nowhere useful to route the cable yet.");
      return true;
    }
    removeItem("hose");
    state.selected = null;
    beginUtilityAction("hoseWire", 2400);
    playSfx("kzzt");
    setLog("You hook the hose around the stuck cable and brace for a proper pull.");
    updateUI();
    return true;
  }

  if (target === "breachFire" && selected === "coldGoo" && state.room === "breachedHallway") {
    reactNope();
    setLog("Way too hot to get that close by hand. Something could grip it over the flames.");
    return true;
  }

  if (target === "breachFire" && selected === "coldGooPole" && state.room === "breachedHallway") {
    beginBreachHeatAction();
    return true;
  }

  if (target === "breachFire" && (selected === "heatedGoo" || selected === "stickyPole" || selected === "hotGooClamp")) {
    setLog("It is already warm and tacky. Any hotter and it will cook solid.");
    return true;
  }

  if (target === "breachHangingPipe" && ["rod", "stickyPole"].includes(selected) && state.room === "breachedHallway") {
    beginBreachPipeFall();
    return true;
  }

  if (target === "breachHangingPipe" && ["specimenPole", "coldGooPole", "hotGooClamp"].includes(selected)) {
    reactNope();
    setLog("The clamp is far too short to reach out over the gap.");
    return true;
  }

  if (target === "breachBridge" && selected === "stickyPole" && state.room === "breachedHallway") {
    if (!state.breachedBridgeExtended) {
      reactNope();
      setLog("There is nothing across the gap to glue yet.");
      return true;
    }
    removeItem("stickyPole");
    state.breachedBridgeLatched = true;
    state.selected = null;
    state.player.facing = "right";
    playCombineTwinkle();
    setLog("You smear hot goo on both ends of the pipe and press them to the ledges. The biomatter sets hard. The pipe holds.");
    updateUI();
    return true;
  }

  if (target === "breachBridge" && selected === "hotGooClamp") {
    reactNope();
    setLog("You could glue the near end, but the far end is out of reach. The clamp needs something longer.");
    return true;
  }

  if (target === "breachBridge" && selected === "coldGooPole") {
    reactNope();
    setLog("The cold goo just slides off the pipe. It needs to be heated first.");
    return true;
  }

  if (target === "breachBridge" && ["heatedGoo", "coldGoo", "specimenPole", "rod"].includes(selected)) {
    reactNope();
    setLog(selected === "rod"
      ? "The pipe rocks when you prod it. It needs something to hold it in place."
      : "The far end is out of reach by hand. You need something long.");
    return true;
  }

  if ((target === "controlCradle" || target === "controlConsole") && selected === "powerCell" && !state.controlCoreSeated) {
    seatControlCore();
    return true;
  }

  if (target === "biomatterConsole" && (selected === "coldGoo" || selected === "coldGooPole" || selected === "heatedGoo" || selected === "hotGooClamp" || selected === "stickyPole")) {
    state.player.facing = "up";
    playSfx("kzzt");
    showBiomatterReadout(selected === "coldGoo" || selected === "coldGooPole"
      ? { title: "SAMPLE 7-G", lines: ["ADHESIVE ABOVE 60°", "HEATER: OFFLINE"], icons: ["heatUp", "heaterOff"], alert: true }
      : { title: "SAMPLE 7-G", lines: ["ADHESIVE: ACTIVE", "BOND WINDOW: SHORT"], icons: ["dropOk", "hourglass"], alert: false });
    setLog(selected === "coldGoo" || selected === "coldGooPole"
      ? "SCAN: Adhesive above 60°, heater offline."
      : "SCAN: Specimen 7-G. Adhesive state confirmed. Bond window is short. Apply to the target quickly.");
    return true;
  }

  reactNope();
  setLog(`${items[selected].name} does not help with that.`);
  return false;
}

function hotspotList() {
  if (state.keypadOpen) return keypadHotspotList();
  if (state.tunerOpen) return tunerHotspotList();
  if (state.room === "controlRoom") return controlRoomHotspotList();
  if (state.room === "breachedHallway") return breachedHallwayHotspotList();
  if (state.room === "biomatter") return biomatterHotspotList();
  if (state.room === "crawlspace") return crawlspaceHotspotList();
  if (state.room === "bathroom") return bathroomHotspotList();
  if (state.room === "hallway") return hallwayHotspotList();
  if (state.room === "utility") return [
    { id: "utilityVent", label: "Vent Back to Hallway", x: 846, y: 48, w: 114, h: 176, action: returnToHallwayVent },
    { id: "utilityHose", label: "Coiled Hose", x: 82, y: 238, w: 110, h: 72, visible: () => !state.utilityHoseCollected, action: () => beginUtilityPickup("hose") },
    { id: "utilityCleanRag", label: "Clean Rag", x: 130, y: 166, w: 60, h: 40, visible: () => !state.utilityCleanRagCollected, action: () => beginUtilityPickup("cleanRag") },
    { id: "utilityToolkit", label: state.utilityToolkitOpen ? "Open Toolkit" : "Toolkit", x: 780, y: 325, w: 125, h: 114, action: interactUtilityToolkit },
    { id: "utilitySlimeBox", label: "Unsteady Box", x: 246, y: 66, w: 92, h: 70, visible: () => !state.utilitySlimeBoxFallen, action: triggerUtilitySlimeBox },
    { id: "utilityWire", label: state.utilityCableRouted ? "Tied Hose" : "Stuck Cable", x: 608, y: 123, w: 67, h: 34, action: pullUtilityWire },
    { id: "utilityDoorButton", label: state.utilityDoorOpen ? "Door Control" : state.utilityCableRouted ? "Powered Door Panel" : state.utilityDoorPanelOpen ? "Opened Door Panel" : "Blue Door Panel", x: 548, y: 79, w: 44, h: 52, action: interactUtilityDoorButton },
    { id: "utilityCenterDoor", label: "Open Utility Door", x: 398, y: 118, w: 110, h: 122, visible: () => state.utilityDoorOpen, action: returnFromUtilityToHallway },
    { id: "utilityEmptyBox", label: "Light Parts Box", x: 711, y: 103, w: 93, h: 96, action: shakeUtilityEmptyBox }
  ].filter(h => !h.visible || h.visible());
  const g = generatedArt.usePreview && generatedArt.backgroundReady;
  return [
    { id: "outerDoor", label: state.outerDoorClosed ? "Closed Outer Hatch" : "Outer Hatch", x: g ? 32 : 34, y: g ? 150 : 270, w: g ? 112 : 122, h: g ? 205 : 245, action: () => hasItem("powerCrystal") ? (state.outerDoorClosed ? reactNope() : escapeShip()) : setLog(state.outerDoorClosed ? "The outer hatch is sealed tight." : "The open outer hatch waits for the pressure controls.") },
    { id: "locker", label: state.lockerOpen ? "Emergency Locker" : "Jammed Emergency Locker", x: g ? 268 : 170, y: g ? 215 : 300, w: g ? 96 : 126, h: g ? 168 : 194, action: openLocker },
    { id: "helmetSpot", label: "Cracked Helmet", x: g ? 230 : 318, y: g ? 398 : 404, w: g ? 128 : 118, h: g ? 88 : 92, visible: () => !hasItem("helmet") && !hasItem("patchedHelmet") && !state.ventSealed, action: collectHelmet },
    { id: "vent", label: state.ventSealed ? "Sealed Vent" : "Screaming Pressure Leak", x: g ? 370 : 506, y: g ? 48 : 112, w: g ? 205 : 124, h: g ? 94 : 92, action: inspectVent },
    { id: "lever", label: "Pressure Lever", x: g ? 560 : 675, y: g ? 250 : 395, w: g ? 94 : 82, h: g ? 126 : 116, action: pullLever },
    { id: "ladder", label: state.onLadder ? "Climb Down" : "Service Ladder", x: g ? 456 : 542, y: g ? 150 : 226, w: g ? 64 : 52, h: g ? 300 : 292, action: useLadder },
    { id: "decoyButton", label: state.decoyButtonBroken ? "Broken Alien Button" : "Suspicious Alien Button", x: g ? 615 : 704, y: g ? 397 : 300, w: g ? 126 : 58, h: g ? 84 : 70, action: pressDecoyButton },
    { id: "cargoCart", label: "Loose Cargo Cart", x: state.cartX - 90, y: 400, w: 180, h: 82, action: pushCargoCart },
    { id: "alienToy", label: "Alien Plush", x: 389, y: 340, w: 49, h: 70, action: inspectAlienToy },
    { id: "tag", label: "Maintenance Tag", x: 515, y: 407, w: 60, h: 64, visible: () => tagIsCollectible() && !hasItem("tag") && !state.scannerSpoofed, action: () => addItem("tag") },
    { id: "scanner", label: state.scannerSpoofed ? "Spoofed Scanner" : "Alien ID Scanner", x: g ? 689 : 772, y: g ? 246 : 238, w: g ? 64 : 70, h: g ? 80 : 120, action: inspectScanner },
    { id: "innerDoor", label: state.complete ? "Open Inner Hatch" : "Inner Airlock Hatch", x: g ? 829 : 842, y: g ? 182 : 178, w: g ? 120 : 86, h: g ? 235 : 292, action: openInnerDoor }
  ]
    .filter(h => !h.visible || h.visible())
    .filter(h => !state.onLadder || h.id === "vent" || h.id === "ladder");
}

function breachedHallwayHotspotList() {
  return [
    { id: "breachLeftOpenDoor", label: "Open Secured Corridor Door", x: 0, y: 135, w: 88, h: 170, action: enterHallwayFromBreach },
    { id: "breachRightOpenDoor", label: "Broken Open Door", x: 832, y: 180, w: 120, h: 210, action: () => state.breachedBridgeLatched ? enterControlRoom() : setLog("The broken door is already open, but the split walkway blocks the route.") },
    { id: "breachNorthDoor", label: state.breachedNorthDoorOpen ? "Open North Door" : "Locked North Door", x: 108, y: 134, w: 148, h: 270, action: state.breachedNorthDoorOpen ? enterBiomatterRoom : openBreachedNorthDoor },
    // Keep the flame ahead of the broad wall-panel target where their
    // rectangles overlap, so hovering the visible fire selects the fire.
    { id: "breachFire", label: "Burning Wreckage", x: 214, y: 260, w: 116, h: 96, action: inspectBreachedFire },
    { id: "breachLeftPanel", label: "Damaged Door Panel", x: 260, y: 168, w: 74, h: 150, action: inspectBreachedLeftPanel },
    { id: "breachHangingPipe", label: "Dangling Pipe", x: BREACHED_HANGING_PIPE_LAYOUT.x, y: BREACHED_HANGING_PIPE_LAYOUT.y, w: BREACHED_HANGING_PIPE_LAYOUT.w, h: BREACHED_HANGING_PIPE_LAYOUT.h, visible: () => !state.breachedBridgeExtended && !state.breachPipeFall, action: inspectBreachedHangingPipe },
    { id: "breachBridge", label: state.breachedBridgeLatched ? "Glued Pipe Bridge" : "Loose Pipe", x: BREACHED_BRIDGE_LAYOUT.x, y: BREACHED_BRIDGE_LAYOUT.y - 6, w: BREACHED_BRIDGE_LAYOUT.w, h: BREACHED_BRIDGE_LAYOUT.h + 12, visible: () => state.breachedBridgeExtended, action: inspectBreachedBridge },
    { id: "breachConsole", label: "Damaged Computer Console", x: 645, y: 210, w: 154, h: 174, action: openBreachedNorthDoor },
    { id: "breachLedge", label: state.breachLevel === "lower" ? "Climb Up" : "Drop Down", x: 566, y: 506, w: 64, h: 58, visible: () => state.breachedBridgeLatched && !state.breachHop, action: beginBreachHop },
    { id: "breachPowerCell", label: "Power Cell", x: 246, y: 534, w: 100, h: 68, visible: () => !state.breachedPowerCellCollected, action: collectBreachedPowerCell }
  ].filter(h => !h.visible || h.visible());
}

function biomatterHotspotList() {
  return [
    { id: "biomatterExit", label: "Back to Breached Hallway", x: 410, y: 560, w: 140, h: 80, action: returnFromBiomatterRoom },
    { id: "biomatterCanisterA", label: "Active Sample Canister", x: 36, y: 44, w: 56, h: 116, action: () => inspectBiomatterCanister("A") },
    { id: "biomatterCanisterB", label: "Sealed Sample Canister", x: 42, y: 220, w: 54, h: 114, action: () => inspectBiomatterCanister("B") },
    { id: "biomatterBrokenCanister", label: state.biomatterGooCollected ? "Shattered Canister Remains" : "Broken Sample Canister", x: 156, y: 366, w: 136, h: 92, action: collectBrokenCanisterGoo },
    { id: "biomatterConsole", label: "Specimen Scanner Console", x: 688, y: 160, w: 114, h: 92, action: operateBiomatterConsole },
    { id: "biomatterRod", label: "Metal Rod", x: BIOMATTER_ROD_LAYOUT.x, y: BIOMATTER_ROD_LAYOUT.y - 6, w: BIOMATTER_ROD_LAYOUT.w, h: BIOMATTER_ROD_LAYOUT.h + 10, visible: () => !state.biomatterRodCollected, action: collectBiomatterRod },
    { id: "biomatterPole", label: "Sample Clamp", x: 826, y: 204, w: 78, h: 74, visible: () => !state.biomatterPoleCollected, action: collectSpecimenPole }
  ].filter(h => !h.visible || h.visible());
}

function openBreachedNorthDoor() {
  if (state.breachedNorthDoorOpen) {
    playSfx("ding");
    setLog("The north door is already open.");
    return;
  }
  state.breachedNorthDoorOpen = true;
  state.player.facing = "up";
  playSfx("ding");
  setLog("The damaged console sends a signal. The north door unlocks.");
  updateUI();
}

function enterBiomatterRoom() {
  state.room = "biomatter";
  state.player.x = state.player.tx = 480;
  state.player.y = state.player.ty = 550;
  state.player.facing = "up";
  state.player.path = [];
  setLog("You enter the cramped biomatter sample room. Something escaped its canister.");
  updateUI();
}

function returnFromBiomatterRoom() {
  state.room = "breachedHallway";
  state.breachLevel = "upper";
  state.player.x = state.player.tx = 184;
  state.player.y = state.player.ty = 336;
  state.player.facing = "down";
  setLog("You step back into the breached hallway.");
  updateUI();
}

// Looking into a sealed specimen canister: the thing inside twitches toward
// the glass and the astronaut recoils in horror, trembling, then recovers.
const BIOMATTER_HORROR_MS = 1900;
function beginBiomatterHorror(slot) {
  state.player.path = [];
  state.player.currentDone = null;
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  state.hover = null;
  state.biomatterHorror = { slot, start: performance.now(), x: state.player.x, y: state.player.y };
  reactNope();
  state.reactionUntil = 0; // the horror pose replaces the regular nope shrug
}
function updateBiomatterHorror() {
  const h = state.biomatterHorror;
  if (performance.now() - h.start < BIOMATTER_HORROR_MS) return;
  state.biomatterHorror = null;
  Object.assign(state.player, { x: h.x, y: h.y, tx: h.x, ty: h.y, facing: h.endFacing || "left", forcedFacing: null });
}
function biomatterHorrorPose() {
  const h = state.biomatterHorror;
  const t = Math.min(1, (performance.now() - h.start) / BIOMATTER_HORROR_MS);
  // Jolt back and up, hold trembling, then ease back to the start spot.
  const jolt = Math.min(1, t / .12);
  const back = t < .75 ? jolt : 1 - (t - .75) / .25;
  const easeBack = back * back * (3 - 2 * back);
  const hop = t < .2 ? Math.sin(Math.min(1, t / .2) * Math.PI) * 14 : 0;
  const shaking = t > .12 && t < .8;
  return {
    t,
    x: h.x + (h.dist || 18) * (h.dir || 1) * easeBack + (shaking ? Math.sin(performance.now() / 22) * 1.6 : 0),
    y: h.y + 6 * easeBack - hop,
    angle: .08 * (h.dir || 1) * easeBack
  };
}
function drawBiomatterHorror(time) {
  const h = state.biomatterHorror;
  if (!h || state.controlDeath) return false;
  const pose = biomatterHorrorPose();
  const t = pose.t;
  // The specimen lunges: a sickly pulse lights up its canister.
  const l = h.slot === "A" ? BIOMATTER_SPRITE_LAYOUTS.biomatterCanisterA : BIOMATTER_SPRITE_LAYOUTS.biomatterCanisterB;
  // Canister glow only for the Room 7 specimens (not the Room 8 creature).
  const pulse = (h.slot === "A" || h.slot === "B") && t < .5 ? Math.sin(Math.min(1, t / .5) * Math.PI) : 0;
  if (pulse > 0) {
    ctx.save();
    ctx.globalCompositeOperation = "lighter";
    const cx = l.x + l.w / 2, cy = l.y + l.h / 2;
    const tint = h.slot === "A" ? "150,255,90" : "200,120,255";
    const g = ctx.createRadialGradient(cx, cy, 4, cx, cy, l.h * .7);
    g.addColorStop(0, `rgba(${tint},${.55 * pulse})`);
    g.addColorStop(1, `rgba(${tint},0)`);
    ctx.fillStyle = g;
    ctx.fillRect(l.x - 40, l.y - 40, l.w + 80, l.h + 80);
    ctx.restore();
    // A thump shakes the canister's glass.
    ctx.save();
    ctx.globalAlpha = .35 * pulse;
    const img = h.slot === "A" ? generatedArt.biomatterCanisterA : null;
    if (img && img.complete && img.naturalWidth) ctx.drawImage(img, l.x + Math.sin(time * 70) * 2, l.y, l.w, l.h);
    ctx.restore();
  }
  // Startled astronaut (front-facing pose from the Room 3 reaction sheet).
  drawUtilityVentPlayerFrame(3, pose.x, pose.y, 1, pose.angle);
  // Sweat drops flying off the helmet.
  const headX = pose.x, headY = pose.y - 150;
  if (t > .15 && t < .85) {
    ctx.save();
    for (let i = 0; i < 3; i++) {
      const st = ((t - .15) / .7 * 1.6 + i * .33) % 1;
      const dir = i === 1 ? -1 : 1;
      const dx = headX + dir * (26 + st * 26) + (i === 2 ? 8 : 0);
      const dy = headY - 18 + st * st * 46 - Math.sin(st * Math.PI) * 18;
      ctx.globalAlpha = 1 - st;
      ctx.fillStyle = "#bfeaff";
      ctx.strokeStyle = "#3a6c8c";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.moveTo(dx, dy - 6);
      ctx.quadraticCurveTo(dx + 4, dy, dx, dy + 3);
      ctx.quadraticCurveTo(dx - 4, dy, dx, dy - 6);
      ctx.fill();
      ctx.stroke();
    }
    ctx.restore();
  }
  return true;
}

function inspectBiomatterCanister(slot) {
  state.player.facing = "up";
  beginBiomatterHorror(slot);
  playSfx("kzzt");
  setLog(slot === "A" ? "The live sample pulses against the glass. The scanner marks it as adhesive when heated." : "This specimen is still sealed. Its violet spores are inert at room temperature.");
}

function operateBiomatterConsole() {
  state.player.facing = "up";
  if (useSelectedOn("biomatterConsole")) return;
  playSfx("kzzt");
  if (!state.biomatterGooCollected) {
    showBiomatterReadout({ title: "SAMPLE 7-G", lines: ["CONTAINMENT LOST"], icons: ["warn"], alert: true });
    setLog("The specimen scanner blinks: SAMPLE 7-G BREACHED. CONTAINMENT LOST. The escaped sample is still pooled on the floor.");
    return;
  }
  showBiomatterReadout({ title: "SCANNER READY", lines: ["PLACE SAMPLE", "ON TRAY"], icons: ["drop", "tray"], alert: false });
  setLog("The scanner wants a sample on the tray. Try the goo you scooped up.");
}

// The Stage 4 text log is hidden, so console results appear as an in-world
// holo readout projected above the specimen scanner for a few seconds.
const BIOMATTER_READOUT_MS = 4200;
function showBiomatterReadout(readout) {
  state.biomatterReadout = { ...readout, start: performance.now() };
}
function drawBiomatterReadout() {
  const r = state.biomatterReadout;
  if (!r || (state.room !== "biomatter" && state.room !== "controlRoom")) return;
  const age = performance.now() - r.start;
  if (age > BIOMATTER_READOUT_MS) {
    state.biomatterReadout = null;
    return;
  }
  const fadeIn = Math.min(1, age / 180);
  const fadeOut = Math.min(1, (BIOMATTER_READOUT_MS - age) / 400);
  const alpha = Math.min(fadeIn, fadeOut);
  const inControl = state.room === "controlRoom";
  const x = inControl ? 690 : 588, y = inControl ? 48 : 70, w = 214, h = 82;
  const beam = inControl ? [[872, 158], [786, 158]] : [[768, 176], [724, 176]];
  const accent = r.alert ? "255,120,120" : "110,242,214";
  ctx.save();
  ctx.globalAlpha = alpha;
  // Projection beam down to the console screen.
  ctx.fillStyle = `rgba(${accent},.10)`;
  ctx.beginPath();
  ctx.moveTo(x + 120, y + h);
  ctx.lineTo(x + w - 10, y + h);
  ctx.lineTo(beam[0][0], beam[0][1]);
  ctx.lineTo(beam[1][0], beam[1][1]);
  ctx.closePath();
  ctx.fill();
  ctx.fillStyle = "rgba(8,20,28,.86)";
  ctx.strokeStyle = `rgba(${accent},.95)`;
  ctx.lineWidth = 2;
  ctx.shadowBlur = 12;
  ctx.shadowColor = `rgba(${accent},.7)`;
  ctx.beginPath();
  ctx.roundRect(x, y, w, h, 8);
  ctx.fill();
  ctx.stroke();
  ctx.shadowBlur = 0;
  // Scanlines.
  ctx.fillStyle = `rgba(${accent},.06)`;
  for (let sy = y + 4; sy < y + h - 2; sy += 4) ctx.fillRect(x + 3, sy, w - 6, 1);
  // Alien script only: English strings are kept in code as the "meaning"
  // and seed the glyphs; the pictograms carry the actual hint.
  drawAlienText(r.title, x + 12, y + 9, 8, "rgba(160,255,236,.9)");
  const blink = r.alert && Math.floor(age / 300) % 2 === 0;
  r.lines.forEach((line, i) => {
    const isLast = i === r.lines.length - 1;
    const color = isLast && r.alert ? (blink ? "rgba(255,130,130,1)" : "rgba(255,130,130,.55)") : "rgba(214,255,246,1)";
    const ly = y + 28 + i * 24;
    if (r.icons && r.icons[i]) drawAlienIcon(r.icons[i], x + 12, ly, 18, color);
    drawAlienText(line, x + 38, ly + 2, 12, color);
  });
  ctx.restore();
}

// ---------- Alien glyph script (shared by every ship console) ----------
// Each pair of letters maps to one fixed glyph, so a word always "reads"
// the same everywhere on the ship.
function alienRng(seed) {
  return () => {
    seed = Math.imul(seed ^ (seed >>> 15), seed | 1) ^ (seed + Math.imul(seed ^ (seed >>> 7), seed | 61));
    return ((seed ^ (seed >>> 14)) >>> 0) / 4294967296;
  };
}
function drawAlienGlyph(seed, gx, gy, s, color) {
  const r = alienRng(Math.imul(seed, 2654435761) >>> 0);
  const pts = [];
  for (let i = 0; i < 3; i++) for (let j = 0; j < 4; j++) pts.push([gx + i * s / 2, gy + j * s / 3]);
  const pick = () => pts[Math.floor(r() * 12)];
  ctx.strokeStyle = color;
  ctx.fillStyle = color;
  ctx.lineWidth = Math.max(1.3, s / 8);
  ctx.lineCap = "round";
  ctx.beginPath();
  ctx.moveTo(gx + s / 2, gy);
  ctx.lineTo(gx + s / 2, gy + s * .3);
  ctx.stroke();
  const n = 3 + Math.floor(r() * 3);
  for (let k = 0; k < n; k++) {
    const a = pick(), b = pick();
    ctx.beginPath();
    ctx.moveTo(a[0], a[1]);
    ctx.lineTo(b[0], b[1]);
    ctx.stroke();
  }
  if (r() < .5) { const c = pick(); ctx.beginPath(); ctx.arc(c[0], c[1], s / 10, 0, Math.PI * 2); ctx.fill(); }
  if (r() < .3) { const c = pick(); ctx.beginPath(); ctx.arc(c[0], c[1], s / 5, 0, Math.PI * 2); ctx.stroke(); }
}
function drawAlienText(text, tx, ty, s, color) {
  ctx.save();
  ctx.shadowColor = color;
  ctx.shadowBlur = 5;
  let cx = tx;
  const words = String(text).toLowerCase().replace(/[^a-z0-9 ]/g, " ").split(/\s+/).filter(Boolean);
  for (const w of words) {
    for (let i = 0; i < w.length; i += 2) {
      drawAlienGlyph(w.charCodeAt(i) * 131 + (w.charCodeAt(i + 1) || 7) * 17 + w.length, cx, ty, s, color);
      cx += s * 1.25;
    }
    cx += s * .8;
  }
  ctx.restore();
  return cx - tx;
}
// Simple pictograms so hints survive without English.
function drawAlienIcon(kind, ix, iy, s, color) {
  ctx.save();
  ctx.strokeStyle = color;
  ctx.fillStyle = color;
  ctx.lineWidth = 1.8;
  ctx.lineCap = "round";
  ctx.lineJoin = "round";
  ctx.shadowColor = color;
  ctx.shadowBlur = 5;
  const cx = ix + s / 2, cy = iy + s / 2;
  const flame = () => {
    ctx.beginPath();
    ctx.moveTo(cx, iy + 1);
    ctx.quadraticCurveTo(ix + s - 2, cy, cx + 3, iy + s - 1);
    ctx.lineTo(cx - 3, iy + s - 1);
    ctx.quadraticCurveTo(ix + 2, cy, cx, iy + 1);
    ctx.stroke();
  };
  const drop = () => {
    ctx.beginPath();
    ctx.moveTo(cx, iy + 1);
    ctx.quadraticCurveTo(ix + s - 2, cy + 2, cx, iy + s - 1);
    ctx.quadraticCurveTo(ix + 2, cy + 2, cx, iy + 1);
    ctx.stroke();
  };
  if (kind === "heatUp") {
    // thermometer with an up arrow
    ctx.beginPath(); ctx.roundRect(ix + 3, iy + 1, 5, s - 7, 2.5); ctx.stroke();
    ctx.beginPath(); ctx.arc(ix + 5.5, iy + s - 4, 3.5, 0, Math.PI * 2); ctx.fill();
    ctx.beginPath(); ctx.moveTo(ix + s - 3, iy + s - 2); ctx.lineTo(ix + s - 3, iy + 2);
    ctx.moveTo(ix + s - 7, iy + 6); ctx.lineTo(ix + s - 3, iy + 2); ctx.lineTo(ix + s + 1, iy + 6); ctx.stroke();
  } else if (kind === "heaterOff") {
    flame();
    ctx.beginPath(); ctx.moveTo(ix + 1, iy + s - 1); ctx.lineTo(ix + s - 1, iy + 1); ctx.stroke();
  } else if (kind === "drop") {
    drop();
  } else if (kind === "dropOk") {
    drop();
    ctx.beginPath(); ctx.moveTo(cx - 3, cy + 2); ctx.lineTo(cx - 1, cy + 5); ctx.lineTo(cx + 3, cy - 1); ctx.stroke();
  } else if (kind === "tray") {
    ctx.beginPath(); ctx.moveTo(cx, iy + 1); ctx.lineTo(cx, iy + s - 7);
    ctx.moveTo(cx - 4, iy + s - 11); ctx.lineTo(cx, iy + s - 7); ctx.lineTo(cx + 4, iy + s - 11);
    ctx.moveTo(ix + 1, iy + s - 5); ctx.lineTo(ix + 3, iy + s - 1); ctx.lineTo(ix + s - 3, iy + s - 1); ctx.lineTo(ix + s - 1, iy + s - 5);
    ctx.stroke();
  } else if (kind === "hourglass") {
    ctx.beginPath(); ctx.moveTo(ix + 3, iy + 1); ctx.lineTo(ix + s - 3, iy + 1); ctx.lineTo(ix + 4, iy + s - 1);
    ctx.lineTo(ix + s - 4, iy + s - 1); ctx.lineTo(ix + 3, iy + 1); ctx.stroke();
  } else if (kind === "coreSlot") {
    ctx.beginPath(); ctx.roundRect(ix + 1, iy + s - 8, s - 2, 7, 3.5); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx, iy); ctx.lineTo(cx, iy + s - 11);
    ctx.moveTo(cx - 4, iy + s - 15); ctx.lineTo(cx, iy + s - 11); ctx.lineTo(cx + 4, iy + s - 15); ctx.stroke();
  } else if (kind === "field") {
    ctx.beginPath(); ctx.moveTo(ix + 1, iy); ctx.lineTo(ix + 1, iy + s); ctx.moveTo(ix + s - 1, iy); ctx.lineTo(ix + s - 1, iy + s); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx, iy + 2); ctx.lineTo(cx + 4, cy); ctx.lineTo(cx, iy + s - 2); ctx.lineTo(cx - 4, cy); ctx.closePath(); ctx.stroke();
  } else if (kind === "wave") {
    ctx.beginPath();
    for (let k = 0; k <= s; k += 1) { const yy = cy + Math.sin(k / s * Math.PI * 4) * (s / 3); k ? ctx.lineTo(ix + k, yy) : ctx.moveTo(ix + k, yy); }
    ctx.stroke();
  } else if (kind === "warn") {
    ctx.beginPath(); ctx.moveTo(cx, iy + 1); ctx.lineTo(ix + s - 1, iy + s - 1); ctx.lineTo(ix + 1, iy + s - 1); ctx.closePath(); ctx.stroke();
    ctx.beginPath(); ctx.moveTo(cx, iy + 6); ctx.lineTo(cx, iy + s - 7); ctx.stroke();
    ctx.beginPath(); ctx.arc(cx, iy + s - 4, 1.2, 0, Math.PI * 2); ctx.fill();
  }
  ctx.restore();
}

// ---------- Room 8: Heart Chamber (control room) ----------
// Seat the bridge power cell in the nav console's cradle, then match the
// core's frequency to the crystal's in the tuner mini game. A held match
// shatters the containment field and frees the power crystal.
const CONTROL_ROOM_FLOOR = [
  [60, 380], [150, 360], [175, 300], [310, 300], [322, 342], [600, 347],
  [700, 347], [760, 362], [845, 396], [915, 440], [950, 460], [950, 630],
  [10, 630], [10, 420]
];
const CONTROL_CRYSTAL_LAYOUT = { x: 416, y: 89, w: 88, h: 138 };
const CONTROL_FIELD_RECT = { x: 392, y: 80, w: 138, h: 150 };
const CONTROL_CRADLE_CORE = { cx: 838.5, cy: 254.5, w: 36, h: 19, angle: .087 };
const CONTROL_SCREEN = { x: 772, y: 158, w: 98, h: 68 };
// Main console screen corners traced from the art: TL, TR, BR, BL.
const CONTROL_SCREEN_QUAD = [[794, 162.5], [868, 159.5], [851.5, 222.5], [773, 215]];
const CONTROL_SHATTER_MS = 1700;

function controlRoomHotspotList() {
  return [
    { id: "controlExit", label: "Back to Breached Hallway", x: 38, y: 40, w: 117, h: 320, action: returnFromControlRoom },
    { id: "controlRadar", label: "Radar Console", x: 207, y: 142, w: 79, h: 129, action: () => inspectRadarConsole("left") },
    { id: "controlWallRadar", label: "Side Console", x: 634, y: 182, w: 93, h: 92, action: () => inspectRadarConsole("wall") },
    { id: "controlCrystal", label: state.controlCrystalReleased ? "Power Crystal" : "Contained Power Crystal", x: 388, y: 70, w: 146, h: 170, visible: () => !state.controlCrystalCollected, action: interactControlCrystal },
    { id: "controlCradle", label: state.controlCoreSeated ? "Seated Power Core" : "Empty Core Cradle", x: 786, y: 226, w: 108, h: 50, action: interactControlCradle },
    { id: "controlConsole", label: "Navigation Console", x: 764, y: 150, w: 128, h: 76, action: interactControlConsole }
  ].filter(h => !h.visible || h.visible());
}

// Decorative radar console by the door: its screen pulses green, but poking
// it does nothing. The astronaut gives up with a shrug after a beat.
const CONTROL_RADAR_SCREEN = { x: 218, y: 150, w: 43, h: 38 };
const CONTROL_WALL_RADAR_SCREEN = { x: 681, y: 191, w: 39, h: 25 };
const CONTROL_RADAR_SHRUG_DELAY_MS = 1500;
let controlRadarTimer = 0;
function inspectRadarConsole(which = "left") {
  state.player.facing = "up";
  if (useSelectedOn(which === "wall" ? "controlWallRadar" : "controlRadar")) return;
  playSfx("boop");
  const now = performance.now();
  if (which === "wall") {
    state.controlWallRadarPokeStart = now;
    state.controlWallRadarLitAt = state.controlWallRadarLitAt || now;
  } else {
    state.controlRadarPokeStart = now;
    state.controlRadarLitAt = state.controlRadarLitAt || now;
  }
  setLog(which === "wall" ? "You tap the flashing red screen. Nothing happens." : "You tap the blinking radar screen. Nothing happens.");
  clearTimeout(controlRadarTimer);
  controlRadarTimer = setTimeout(() => {
    controlRadarTimer = 0;
    if (state.room !== "controlRoom" || state.tunerOpen) return;
    state.player.facing = "down";
    reactNope();
  }, CONTROL_RADAR_SHRUG_DELAY_MS);
}

function drawRadarScreenFlash(time) {
  drawScreenPulse(generatedArt.controlRadarScreenMask, state.controlRadarLitAt, state.controlRadarPokeStart, time, 1.6, [70, 255, 120]);
  drawScreenPulse(generatedArt.controlSideScreenMask, state.controlWallRadarLitAt, state.controlWallRadarPokeStart, time + 1.3, 1.4, [255, 60, 60]);
}

// Screen tints use masks traced from the painted screens, so the glow sits
// exactly on each (slanted) screen instead of a rectangle.
const screenPulseCanvas = document.createElement("canvas");
screenPulseCanvas.width = 960;
screenPulseCanvas.height = 640;
const screenPulseCtx = screenPulseCanvas.getContext("2d");
function drawScreenPulse(mask, litAt, pokeStart, time, speed, rgb) {
  if (!(mask && mask.complete && mask.naturalWidth > 0)) return;
  // Screens stay dark until the player taps them; then they fade in and keep
  // a slow breathing pulse, with a brighter blip right after the tap.
  if (!litAt) return;
  const poke = performance.now() - pokeStart;
  const fadeIn = Math.min(1, (performance.now() - litAt) / 500);
  let a = .1 + .22 * (.5 + .5 * Math.sin(time * speed));
  if (poke < 600) a += .3 * (1 - poke / 600);
  a *= fadeIn;
  const tint = alpha => {
    screenPulseCtx.globalCompositeOperation = "source-over";
    screenPulseCtx.clearRect(0, 0, 960, 640);
    screenPulseCtx.drawImage(mask, 0, 0, 960, 640);
    screenPulseCtx.globalCompositeOperation = "source-in";
    screenPulseCtx.fillStyle = `rgba(${rgb[0]},${rgb[1]},${rgb[2]},${alpha})`;
    screenPulseCtx.fillRect(0, 0, 960, 640);
    return screenPulseCanvas;
  };
  ctx.save();
  // Recolor the painted screen to the pulse hue, then add the glow on top.
  ctx.globalCompositeOperation = "color";
  ctx.drawImage(tint(.9 * fadeIn), 0, 0);
  ctx.globalCompositeOperation = "lighter";
  ctx.shadowColor = `rgba(${rgb[0]},${rgb[1]},${rgb[2]},.9)`;
  ctx.shadowBlur = 12 * a;
  ctx.drawImage(tint(a), 0, 0);
  ctx.restore();
}

function enterControlRoom() {
  state.room = "controlRoom";
  state.player.x = state.player.tx = 150;
  state.player.y = state.player.ty = 400;
  state.player.facing = "right";
  state.player.path = [];
  setLog(state.controlCrystalCollected ? "You slip back into the heart chamber." : "You step through the broken door into the ship's heart chamber. A crystal hums inside a shimmering field.");
  if (!state.chaseActive) {
    state.controlAlien = null;
    clearTimeout(controlAlienTimer);
    if (state.controlCrystalCollected) controlAlienTimer = setTimeout(beginControlAlien, 900);
  }
  updateUI();
}

function returnFromControlRoom() {
  closeTuner();
  // During the chase the creature follows through the door (see updateChase).
  if (!state.chaseActive) {
    state.controlAlien = null;
    clearTimeout(controlAlienTimer);
  }
  state.room = "breachedHallway";
  state.breachLevel = "upper";
  state.player.x = state.player.tx = 868;
  state.player.y = state.player.ty = 386;
  state.player.facing = "left";
  state.player.path = [];
  setLog("You step back into the breached hallway.");
  updateUI();
}

function seatControlCore() {
  removeItem("powerCell");
  state.controlCoreSeated = true;
  state.selected = null;
  state.player.facing = "up";
  playSfx("clank");
  popComic("KA-CHUNK", 840, 214, "#7cf5de");
  showBiomatterReadout({ title: "nav core online", lines: ["resonance mismatch"], icons: ["wave"], alert: true });
  setLog("The power cell locks into the cradle. The navigation console flickers awake.");
  updateUI();
}

function interactControlCradle() {
  state.player.facing = "up";
  if (useSelectedOn("controlCradle")) return;
  if (!state.controlCoreSeated) {
    playSfx("kzzt");
    showBiomatterReadout({ title: "nav core", lines: ["core missing"], icons: ["coreSlot"], alert: true });
    setLog("An empty cradle between two clamps. Something cylindrical fits here.");
    return;
  }
  interactControlConsole();
}

function interactControlConsole() {
  state.player.facing = "up";
  if (useSelectedOn("controlConsole")) return;
  if (!state.controlCoreSeated) {
    playSfx("kzzt");
    showBiomatterReadout({ title: "nav core", lines: ["no power"], icons: ["coreSlot"], alert: true });
    setLog("The console is dark. Its core cradle is empty.");
    return;
  }
  if (state.controlCrystalReleased) {
    playSfx("boop");
    showBiomatterReadout({ title: "resonance locked", lines: ["field down"], icons: ["field"], alert: false });
    setLog("The console shows a steady, matched wave.");
    return;
  }
  openTuner();
}

function interactControlCrystal() {
  state.player.facing = "up";
  if (state.controlShatterStart && performance.now() - state.controlShatterStart < CONTROL_SHATTER_MS) return;
  if (!state.controlCrystalReleased) {
    if (useSelectedOn("controlCrystal")) return;
    reactNope();
    playSfx("kzzt");
    popComic("BZZT!", 470, 250, "#9fe8ff");
    setLog("The containment field snaps at your glove. Something must be keeping it up.");
    return;
  }
  state.controlCrystalCollected = true;
  addItem("powerCrystal");
  playSfx("ding");
  setLog("You lift the power crystal free. The whole ship seems to exhale.");
  // Taking the ship's heart wakes something up.
  clearTimeout(controlAlienTimer);
  controlAlienTimer = setTimeout(beginControlAlien, 900);
}

// ---------- Tuner mini game ----------
const TUNER = {
  panel: { x: 190, y: 80, w: 580, h: 480 },
  scope: { x: 214, y: 120, w: 532, h: 210 },
  fMin: 1, fMax: 6, fStep: .25,
  aMin: 1, aMax: 9, aStep: 1,
  holdMs: 2000,
  buttons: {
    up: { x: 302, y: 362, w: 56, h: 56 },
    left: { x: 238, y: 426, w: 56, h: 56 },
    right: { x: 366, y: 426, w: 56, h: 56 },
    down: { x: 302, y: 490, w: 56, h: 56 }
  }
};

function tunerRandom(lo, hi, step) {
  return lo + step * Math.floor(Math.random() * ((hi - lo) / step + 1));
}

function openTuner() {
  if (!state.tuner) {
    const target = { f: tunerRandom(2, 5, TUNER.fStep), a: tunerRandom(3, 8, TUNER.aStep) };
    let core;
    do core = { f: tunerRandom(TUNER.fMin, TUNER.fMax, TUNER.fStep), a: tunerRandom(TUNER.aMin, TUNER.aMax, TUNER.aStep) };
    while (Math.abs(core.f - target.f) < 1.5 && Math.abs(core.a - target.a) < 3);
    state.tuner = { tf: target.f, ta: target.a, f: core.f, a: core.a, sync: 0, won: false, wonAt: 0, last: performance.now() };
  }
  state.tuner.last = performance.now();
  state.tunerOpen = true;
  state.hover = null;
  playSfx("boop");
}

function closeTuner() {
  state.tunerOpen = false;
  state.hover = null;
}

function tunerHotspotList() {
  const b = TUNER.buttons;
  return [
    { id: "tuner-up", label: "", ...b.up, action: () => tunerAdjust(0, TUNER.aStep) },
    { id: "tuner-down", label: "", ...b.down, action: () => tunerAdjust(0, -TUNER.aStep) },
    { id: "tuner-left", label: "", ...b.left, action: () => tunerAdjust(-TUNER.fStep, 0) },
    { id: "tuner-right", label: "", ...b.right, action: () => tunerAdjust(TUNER.fStep, 0) },
    { id: "tuner-close", label: "", x: 728, y: 90, w: 32, h: 32, action: closeTuner }
  ];
}

function tunerAdjust(df, da) {
  const t = state.tuner;
  if (!t || t.won) return;
  t.f = Math.min(TUNER.fMax, Math.max(TUNER.fMin, +(t.f + df).toFixed(2)));
  t.a = Math.min(TUNER.aMax, Math.max(TUNER.aMin, t.a + da));
  playSfx("boop");
}

function tunerError(t) {
  return Math.abs(t.f - t.tf) / (TUNER.fMax - TUNER.fMin) + Math.abs(t.a - t.ta) / (TUNER.aMax - TUNER.aMin);
}

function updateTuner() {
  const t = state.tuner;
  if (!t) return;
  const now = performance.now();
  const dt = Math.min(.1, (now - t.last) / 1000);
  t.last = now;
  if (t.won) {
    if (state.tunerOpen && now - t.wonAt > 1400) {
      closeTuner();
      beginControlShatter();
    }
    return;
  }
  const exact = tunerError(t) < .001;
  t.sync = exact ? Math.min(1, t.sync + dt / (TUNER.holdMs / 1000)) : Math.max(0, t.sync - dt * 1.5);
  if (t.sync >= 1) {
    t.won = true;
    t.wonAt = now;
    playSfx("ding");
  }
}

function beginControlShatter() {
  state.controlCrystalReleased = true;
  state.controlShatterStart = performance.now();
  playSfx("whoosh");
  popComic("KSSHHH!", 470, 70, "#e7b8ff");
  setLog("The core and crystal hum in unison. The containment field shatters into light.");
  updateUI();
}

window.addEventListener("keydown", event => {
  if (!state.tunerOpen) return;
  const moves = { ArrowLeft: [-TUNER.fStep, 0], ArrowRight: [TUNER.fStep, 0], ArrowUp: [0, TUNER.aStep], ArrowDown: [0, -TUNER.aStep] };
  if (moves[event.key]) {
    event.preventDefault();
    tunerAdjust(...moves[event.key]);
  } else if (event.key === "Escape") {
    closeTuner();
  }
});

function drawTunerWave(sc, f, a, color, width, jitter, phase) {
  ctx.strokeStyle = color;
  ctx.lineWidth = width;
  ctx.shadowColor = color;
  ctx.shadowBlur = 12;
  ctx.beginPath();
  const mid = sc.y + sc.h / 2;
  for (let x = 0; x <= sc.w; x += 3) {
    const y = mid + Math.sin(x / sc.w * f * Math.PI * 2 + phase) * (a / 10) * (sc.h / 2 - 12) + (Math.random() - .5) * jitter;
    x ? ctx.lineTo(sc.x + x, y) : ctx.moveTo(sc.x + x, y);
  }
  ctx.stroke();
  ctx.shadowBlur = 0;
}

function drawTunerPips(px, py, pw, count, isOn) {
  const gap = 3;
  const w = (pw - gap * (count - 1)) / count;
  for (let i = 0; i < count; i++) {
    const on = isOn(i);
    ctx.fillStyle = on ? "#7ef" : "#0e2230";
    ctx.strokeStyle = "#1d4a5a";
    ctx.lineWidth = 1;
    ctx.shadowBlur = on ? 6 : 0;
    ctx.shadowColor = "#7ef";
    ctx.beginPath();
    ctx.roundRect(px + i * (w + gap), py, w, 10, 2);
    ctx.fill();
    ctx.stroke();
  }
  ctx.shadowBlur = 0;
}

function drawTuner(time) {
  const t = state.tuner;
  if (!state.tunerOpen || !t) return;
  const P = TUNER.panel, S = TUNER.scope;
  const err = tunerError(t);
  const exact = err < .001, near = err < .12;
  ctx.save();
  ctx.fillStyle = "rgba(2,5,12,.72)";
  ctx.fillRect(0, 0, 960, 640);
  // Console frame.
  const g = ctx.createLinearGradient(0, P.y, 0, P.y + P.h);
  g.addColorStop(0, "#0c1624");
  g.addColorStop(1, "#070b13");
  ctx.fillStyle = g;
  ctx.strokeStyle = "#2b6d80";
  ctx.lineWidth = 2;
  ctx.shadowBlur = 24;
  ctx.shadowColor = "rgba(0,255,255,.25)";
  ctx.beginPath();
  ctx.roundRect(P.x, P.y, P.w, P.h, 14);
  ctx.fill();
  ctx.stroke();
  ctx.shadowBlur = 0;
  drawAlienText("navcore resonance", P.x + 24, P.y + 14, 14, "#6de");
  // Close button (symbol only).
  const hoverId = state.hover && state.hover.id;
  ctx.strokeStyle = hoverId === "tuner-close" ? "#fff" : "#7ef";
  ctx.lineWidth = 2.5;
  ctx.beginPath();
  ctx.moveTo(736, 98); ctx.lineTo(752, 114);
  ctx.moveTo(752, 98); ctx.lineTo(736, 114);
  ctx.stroke();
  // Oscilloscope.
  ctx.fillStyle = "#02050a";
  ctx.strokeStyle = "#1d4a5a";
  ctx.lineWidth = 1;
  ctx.beginPath();
  ctx.roundRect(S.x, S.y, S.w, S.h, 8);
  ctx.fill();
  ctx.stroke();
  ctx.save();
  ctx.beginPath();
  ctx.roundRect(S.x, S.y, S.w, S.h, 8);
  ctx.clip();
  ctx.strokeStyle = "#0d2a33";
  for (let x = S.x; x < S.x + S.w; x += 38) { ctx.beginPath(); ctx.moveTo(x, S.y); ctx.lineTo(x, S.y + S.h); ctx.stroke(); }
  for (let y = S.y; y < S.y + S.h; y += 35) { ctx.beginPath(); ctx.moveTo(S.x, y); ctx.lineTo(S.x + S.w, y); ctx.stroke(); }
  drawTunerWave(S, t.tf, t.ta, "#3ef", 2, 0, time * 2);
  const coreColor = t.won || exact ? "#5f8" : near ? "#fb3" : "#f55";
  drawTunerWave(S, t.f, t.a, coreColor, 2.5, t.won ? 0 : Math.min(18, err * 40), time * 2 + (exact || t.won ? 0 : Math.sin(time * 3) * .6));
  if (t.won) {
    const flash = Math.max(0, 1 - (performance.now() - t.wonAt) / 1200);
    ctx.fillStyle = `rgba(120,255,200,${flash * .5})`;
    ctx.fillRect(S.x, S.y, S.w, S.h);
  }
  ctx.restore();
  // D-pad.
  const arrows = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] };
  for (const [key, b] of Object.entries(TUNER.buttons)) {
    const hovered = hoverId === `tuner-${key}`;
    ctx.fillStyle = hovered ? "#1d4a5a" : "#0e2230";
    ctx.strokeStyle = hovered ? "#9ff" : "#2b6d80";
    ctx.lineWidth = hovered ? 2 : 1;
    ctx.beginPath();
    ctx.roundRect(b.x, b.y, b.w, b.h, 8);
    ctx.fill();
    ctx.stroke();
    const [dx, dy] = arrows[key];
    const cx = b.x + b.w / 2, cy = b.y + b.h / 2;
    ctx.fillStyle = "#7ef";
    ctx.beginPath();
    ctx.moveTo(cx + dx * 11, cy + dy * 11);
    ctx.lineTo(cx - dx * 7 + dy * 10, cy - dy * 7 + dx * 10);
    ctx.lineTo(cx - dx * 7 - dy * 10, cy - dy * 7 - dx * 10);
    ctx.closePath();
    ctx.fill();
  }
  drawAlienText("tune", 312, 446, 11, "#3a8");
  // Readouts: frequency and amplitude pips, sync meter, glyph status.
  const ix = 450, iw = 296;
  const fCount = (TUNER.fMax - TUNER.fMin) / TUNER.fStep + 1;
  const fIndex = Math.round((t.f - TUNER.fMin) / TUNER.fStep);
  drawAlienIcon("wave", ix, 372, 22, "#6de");
  drawTunerPips(ix + 34, 378, iw - 34, fCount, i => i === fIndex);
  ctx.save();
  ctx.strokeStyle = "#6de";
  ctx.lineWidth = 2;
  ctx.beginPath();
  for (let k = 0; k <= 22; k++) { const yy = 420 + Math.sin(k / 22 * Math.PI * 2) * 8; k ? ctx.lineTo(ix + k, yy) : ctx.moveTo(ix + k, yy); }
  ctx.stroke();
  ctx.restore();
  drawTunerPips(ix + 34, 414, iw - 34, TUNER.aMax - TUNER.aMin + 1, i => i <= t.a - TUNER.aMin);
  drawAlienText("sync", ix, 446, 11, "#6de");
  ctx.fillStyle = "#0e2230";
  ctx.strokeStyle = "#2b6d80";
  ctx.beginPath();
  ctx.roundRect(ix + 34, 448, iw - 34, 14, 7);
  ctx.fill();
  ctx.stroke();
  ctx.fillStyle = exact || t.won ? "#5f8" : "#fb3";
  if (t.sync > 0 || t.won) {
    ctx.beginPath();
    ctx.roundRect(ix + 34, 448, (iw - 34) * (t.won ? 1 : t.sync), 14, 7);
    ctx.fill();
  }
  if (t.won) drawAlienText("krystal vaar oshenna", ix, 488, 13, "#5f8");
  else if (exact) drawAlienText("thessa", ix, 488, 13, "#5f8");
  else if (near) drawAlienText("oluun ki", ix, 488, 13, "#fb3");
  else if (Math.floor(time * 3) % 2 === 0) drawAlienText("kzar vetha", ix, 488, 13, "#f66");
  ctx.restore();
}

// ---------- Room 8 drawing ----------
function drawControlShatter() {
  if (!state.controlShatterStart) return;
  const age = performance.now() - state.controlShatterStart;
  if (age > CONTROL_SHATTER_MS) return;
  const k = age / CONTROL_SHATTER_MS;
  const F = CONTROL_FIELD_RECT;
  const cx = F.x + F.w / 2, cy = F.y + F.h / 2;
  ctx.save();
  // Flash.
  ctx.fillStyle = `rgba(235,200,255,${Math.max(0, .75 - k * 1.6)})`;
  ctx.fillRect(0, 0, 960, 640);
  // Glass shards flying outward.
  for (let i = 0; i < 26; i++) {
    const ang = i * 2.39996 + (i % 3) * .3;
    const speed = 180 + (i * 37) % 160;
    const d = speed * k;
    const x = cx + Math.cos(ang) * (F.w * .4 + d);
    const y = cy + Math.sin(ang) * (F.h * .4 + d) + 160 * k * k;
    ctx.save();
    ctx.translate(x, y);
    ctx.rotate(ang + k * 8);
    ctx.globalAlpha = 1 - k;
    ctx.fillStyle = i % 2 ? "rgba(140,240,255,.9)" : "rgba(220,170,255,.9)";
    ctx.beginPath();
    ctx.moveTo(0, -7);
    ctx.lineTo(4, 3);
    ctx.lineTo(-3, 5);
    ctx.closePath();
    ctx.fill();
    ctx.restore();
  }
  // Expanding ring.
  ctx.strokeStyle = `rgba(200,160,255,${1 - k})`;
  ctx.lineWidth = 4 * (1 - k) + 1;
  ctx.beginPath();
  ctx.ellipse(cx, cy, 40 + k * 260, 30 + k * 170, 0, 0, Math.PI * 2);
  ctx.stroke();
  ctx.restore();
}

function drawControlRoomDetails(time) {
  const F = CONTROL_FIELD_RECT;
  // Once the field is down, fade to the field-off plate (empty chamber);
  // the freed crystal is drawn on top as a floating sprite until taken.
  if (state.controlCrystalReleased) {
    const shatterK = state.controlShatterStart ? Math.min(1, (performance.now() - state.controlShatterStart) / (CONTROL_SHATTER_MS * .45)) : 1;
    void shatterK; // field-off plate is drawn with the background (see drawGeneratedControlRoom)
    const img = generatedArt.controlCrystal;
    if (!state.controlCrystalCollected && img.complete && img.naturalWidth) {
      const c = CONTROL_CRYSTAL_LAYOUT;
      const bob = Math.sin(time * 2.2) * 4;
      ctx.save();
      ctx.shadowColor = "rgba(210,120,255,.9)";
      ctx.shadowBlur = 26;
      ctx.drawImage(img, c.x, c.y + bob, c.w, c.h);
      ctx.restore();
    }
  }
  if (state.controlCoreSeated) {
    // Seated core: light up the painted tube between the clamp rings using a
    // mask traced from the art, so the glow follows its exact shape and tilt.
    const tube = generatedArt.controlCoreTubeMask;
    if (tube.complete && tube.naturalWidth > 0) {
      const pulse = .75 + Math.sin(time * 4) * .2;
      const tx = screenPulseCtx;
      tx.save();
      tx.globalCompositeOperation = "source-over";
      tx.clearRect(0, 0, 960, 640);
      const g = tx.createLinearGradient(0, 242, 0, 266);
      g.addColorStop(0, `rgba(200,255,255,${.95 * pulse})`);
      g.addColorStop(.35, `rgba(80,230,245,${.85 * pulse})`);
      g.addColorStop(1, `rgba(0,110,130,${.7 * pulse})`);
      tx.fillStyle = g;
      tx.fillRect(815, 238, 50, 32);
      tx.globalCompositeOperation = "destination-in";
      tx.drawImage(tube, 0, 0, 960, 640);
      tx.restore();
      ctx.save();
      ctx.shadowColor = "rgba(120,245,255,.9)";
      ctx.shadowBlur = 14 * pulse;
      ctx.drawImage(screenPulseCanvas, 0, 0);
      ctx.restore();
    }
    // Screen wakes up: target wave, green once the field is down. Drawn
    // offscreen and cut to the traced screen shape so it fits the glass.
    const mask = generatedArt.controlNavScreenMask;
    if (mask.complete && mask.naturalWidth > 0) {
      const sc = CONTROL_SCREEN;
      const color = state.controlCrystalReleased ? "rgba(110,255,150,.9)" : "rgba(120,240,255,.85)";
      const sx = screenPulseCtx;
      sx.save();
      sx.globalCompositeOperation = "source-over";
      sx.clearRect(0, 0, 960, 640);
      sx.fillStyle = "rgba(0,30,40,.35)";
      sx.fillRect(sc.x, sc.y, sc.w, sc.h);
      sx.strokeStyle = color;
      sx.shadowColor = color;
      sx.shadowBlur = 6;
      sx.lineWidth = 1.8;
      sx.beginPath();
      // Map the wave onto the slanted screen quad (TL, TR, BR, BL).
      const [q0, q1, q2, q3] = CONTROL_SCREEN_QUAD;
      const at = (u, v) => {
        const tx0 = q0[0] + (q1[0] - q0[0]) * u, ty0 = q0[1] + (q1[1] - q0[1]) * u;
        const bx0 = q3[0] + (q2[0] - q3[0]) * u, by0 = q3[1] + (q2[1] - q3[1]) * u;
        return [tx0 + (bx0 - tx0) * v, ty0 + (by0 - ty0) * v];
      };
      for (let i = 0; i <= 80; i++) {
        const u = .08 + .84 * i / 80;
        const v = .5 + Math.sin(u * Math.PI * 5 + time * 3) * .28;
        const [px, py] = at(u, v);
        i ? sx.lineTo(px, py) : sx.moveTo(px, py);
      }
      sx.stroke();
      sx.shadowBlur = 0;
      sx.globalCompositeOperation = "destination-in";
      sx.drawImage(mask, 0, 0, 960, 640);
      sx.restore();
      ctx.drawImage(screenPulseCanvas, 0, 0);
    }
  }
}

function controlRoomMask(id) {
  if (state.room !== "controlRoom") return null;
  return {
    controlExit: generatedArt.controlExitMask,
    controlCrystal: generatedArt.controlCrystalMask,
    controlCradle: generatedArt.controlCradleMask,
    controlConsole: generatedArt.controlConsoleMask,
    controlRadar: generatedArt.controlRadarMask,
    controlWallRadar: generatedArt.controlWallRadarMask
  }[id] || null;
}

// Clicks and hover use the same traced masks as the highlights, so the
// clickable area matches the painted object instead of a rectangle.
const controlMaskAlphaCache = new Map();
function controlMaskHit(id, point) {
  const img = controlRoomMask(id);
  if (!img || !(img.complete && img.naturalWidth > 0)) return null;
  let data = controlMaskAlphaCache.get(img);
  if (!data) {
    const c = document.createElement("canvas");
    c.width = 960;
    c.height = 640;
    const cx = c.getContext("2d", { willReadFrequently: true });
    cx.drawImage(img, 0, 0, 960, 640);
    try {
      data = cx.getImageData(0, 0, 960, 640).data;
    } catch (err) {
      return null;
    }
    controlMaskAlphaCache.set(img, data);
  }
  const x = Math.round(point.x), y = Math.round(point.y);
  if (x < 0 || y < 0 || x >= 960 || y >= 640) return false;
  return data[(y * 960 + x) * 4 + 3] > 40;
}

// ---------- Alien ambush after the crystal is taken ----------
const CONTROL_ALIEN_CELL = { w: 418, h: 314 };
const CONTROL_ALIEN_ROWS = { up: 0, left: 1, down: 2, right: 3 };
const CONTROL_ALIEN_SCALE = .62;
const CONTROL_ALIEN_SPEED = 150; // px per second
let controlAlienTimer = 0;
function beginControlAlien() {
  controlAlienTimer = 0;
  if (state.room !== "controlRoom" || state.controlAlien) return;
  // Emerge from the bottom-right corner, then creep toward the player.
  state.controlAlien = { room: "controlRoom", x: 1010, y: 680, tx: 900, ty: 560, start: performance.now(), last: performance.now(), emerging: true, facing: "left", caughtAt: 0 };
  state.chaseActive = true;
  state.chasePending = null;
  state.chasePlayerRoom = "controlRoom";
  playAlienScream(1, .95);
  popComic("SKREEE!", 860, 520, "#e7a0ff");
  // Startled jump away from the corner it crawls out of.
  if (!state.biomatterHorror && !state.tunerOpen) {
    beginBiomatterHorror("alien");
    state.biomatterHorror.dir = -1;
    state.biomatterHorror.dist = 42;
    state.biomatterHorror.endFacing = "right";
  }
  setLog("Something skitters out of the dark corner. Get back to the door!");
}

const CONTROL_ALIEN_CREEP_SPEED = 42; // very slow stalk
const CONTROL_ALIEN_EMERGE_SPEED = 120;
const CONTROL_ALIEN_CATCH_DIST = 58;
function updateControlAlien() {
  const a = state.controlAlien;
  if (!a) return;
  const now = performance.now();
  const dt = Math.min(.1, (now - a.last) / 1000);
  a.last = now;
  if (a.caughtAt) {
    // Brief grab, then the chase restarts from the pedestal.
    if (now - a.caughtAt > CONTROL_DEATH_MS + 300) {
      state.controlDeath = null;
      resetControlRoomAfterDeath();
    }
    return;
  }
  if (a.emerging) {
    a.tx = 900;
    a.ty = 560;
  } else {
    a.tx = state.player.x;
    a.ty = state.player.y;
  }
  const dx = a.tx - a.x, dy = a.ty - a.y;
  const dist = Math.hypot(dx, dy);
  if (!a.emerging && dist < CONTROL_ALIEN_CATCH_DIST) {
    a.caughtAt = now;
    state.player.path = [];
    state.player.currentDone = null;
    state.player.tx = state.player.x;
    state.player.ty = state.player.y;
    state.controlDeath = { start: now, x: state.player.x, y: state.player.y };
    state.biomatterHorror = null;
    playAlienScream(1.18, .75);
    popComic("GRAB!", state.player.x, state.player.y - 120, "#ff8fa8");
    setLog("The creature lunges. Everything goes dark...");
    return;
  }
  const step = (a.emerging ? CONTROL_ALIEN_EMERGE_SPEED : CONTROL_ALIEN_CREEP_SPEED) * dt;
  if (a.emerging && dist <= step) {
    a.x = a.tx;
    a.y = a.ty;
    a.emerging = false;
    return;
  }
  let mx = dx, my = dy, md = dist, mstep = step;
  if (!a.emerging) {
    // Walk the same floor the player walks (bridge, canister, props), not a straight line.
    const wp = alienNextWaypoint(a, now);
    if (wp) { mx = wp.x - a.x; my = wp.y - a.y; md = Math.hypot(mx, my); }
  }
  if (md > 0.5) {
    const k = Math.min(mstep, md) / md;
    a.x += mx * k;
    a.y += my * k;
    a.facing = Math.abs(mx) > Math.abs(my) * .7 ? (mx < 0 ? "left" : "right") : (my < 0 ? "up" : "down");
  }
}

// ---- Alien floor pathing: grid A* over the room's walkable floor ----
const ALIEN_CELL = 8;
const ALIEN_COLS = 120, ALIEN_ROWS = 80;
function alienGround(p) {
  if (p.x < 0 || p.y < 0 || p.x > 960 || p.y > 640) return false;
  if (state.room !== "breachedHallway") return isGroundTile(p);
  // The creature always walks the upper deck (and the bridge once it is latched).
  const lvl = state.breachLevel;
  state.breachLevel = "upper";
  const r = isGroundTile(p);
  state.breachLevel = lvl;
  return r;
}
function alienSegmentClear(a, b) {
  const n = Math.max(2, Math.ceil(Math.hypot(b.x - a.x, b.y - a.y) / 5));
  for (let i = 0; i <= n; i++) {
    const t = i / n;
    if (!alienGround({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t })) return false;
  }
  return true;
}
function alienNearestGround(p) {
  if (alienGround(p)) return { x: p.x, y: p.y };
  for (let r = ALIEN_CELL; r <= 240; r += ALIEN_CELL) {
    let best = null, bd = Infinity;
    for (let i = 0; i < 24; i++) {
      const ang = i / 24 * Math.PI * 2;
      const q = { x: p.x + Math.cos(ang) * r, y: p.y + Math.sin(ang) * r };
      if (alienGround(q)) { const d = Math.hypot(q.x - p.x, q.y - p.y); if (d < bd) { bd = d; best = q; } }
    }
    if (best) return best;
  }
  return null;
}
function alienPlanPath(from, to) {
  const start = alienNearestGround(from), goal = alienNearestGround(to);
  if (!start || !goal) return [];
  if (alienSegmentClear(start, goal)) return [goal];
  const walk = new Int8Array(ALIEN_COLS * ALIEN_ROWS).fill(-1);
  const ok = (c, r) => {
    if (c < 0 || r < 0 || c >= ALIEN_COLS || r >= ALIEN_ROWS) return false;
    const i = r * ALIEN_COLS + c;
    if (walk[i] < 0) walk[i] = alienGround({ x: c * ALIEN_CELL + ALIEN_CELL / 2, y: r * ALIEN_CELL + ALIEN_CELL / 2 }) ? 1 : 0;
    return walk[i] === 1;
  };
  const cellOf = p => [Math.min(ALIEN_COLS - 1, Math.floor(p.x / ALIEN_CELL)), Math.min(ALIEN_ROWS - 1, Math.floor(p.y / ALIEN_CELL))];
  const [sc, sr] = cellOf(start), [gc, gr] = cellOf(goal);
  const N = ALIEN_COLS * ALIEN_ROWS;
  const g = new Float32Array(N).fill(Infinity), prev = new Int32Array(N).fill(-1), closed = new Uint8Array(N);
  const heap = [];
  const push = (f, i) => { heap.push([f, i]); let k = heap.length - 1; while (k > 0) { const pk = (k - 1) >> 1; if (heap[pk][0] <= heap[k][0]) break; [heap[pk], heap[k]] = [heap[k], heap[pk]]; k = pk; } };
  const pop = () => { const top = heap[0], last = heap.pop(); if (heap.length) { heap[0] = last; let k = 0; for (;;) { let l = 2 * k + 1, r = l + 1, m = k; if (l < heap.length && heap[l][0] < heap[m][0]) m = l; if (r < heap.length && heap[r][0] < heap[m][0]) m = r; if (m === k) break; [heap[m], heap[k]] = [heap[k], heap[m]]; k = m; } } return top; };
  const si = sr * ALIEN_COLS + sc, gi = gr * ALIEN_COLS + gc;
  g[si] = 0; push(0, si);
  const h = (c, r) => { const dx = Math.abs(c - gc), dy = Math.abs(r - gr); return (dx + dy) + (Math.SQRT2 - 2) * Math.min(dx, dy); };
  let found = false;
  while (heap.length) {
    const [, u] = pop();
    if (closed[u]) continue;
    closed[u] = 1;
    if (u === gi) { found = true; break; }
    const uc = u % ALIEN_COLS, ur = (u / ALIEN_COLS) | 0;
    for (let dr = -1; dr <= 1; dr++) for (let dc = -1; dc <= 1; dc++) {
      if (!dc && !dr) continue;
      const nc = uc + dc, nr = ur + dr;
      if (!ok(nc, nr)) continue;
      if (dc && dr && (!ok(uc + dc, ur) || !ok(uc, ur + dr))) continue;
      const v = nr * ALIEN_COLS + nc;
      const ng = g[u] + (dc && dr ? Math.SQRT2 : 1);
      if (ng < g[v]) { g[v] = ng; prev[v] = u; push(ng + h(nc, nr), v); }
    }
  }
  if (!found) return [];
  const raw = [];
  for (let v = gi; v !== -1 && v !== si; v = prev[v]) raw.unshift({ x: (v % ALIEN_COLS) * ALIEN_CELL + ALIEN_CELL / 2, y: ((v / ALIEN_COLS) | 0) * ALIEN_CELL + ALIEN_CELL / 2 });
  raw[raw.length - 1] = goal;
  // String-pull: skip to the farthest point with clear floor in between.
  const out = [];
  let cur = start, i = 0;
  while (i < raw.length) {
    let j = raw.length - 1;
    while (j > i && !alienSegmentClear(cur, raw[j])) j--;
    out.push(raw[j]);
    cur = raw[j];
    i = j + 1;
  }
  return out;
}
function alienNextWaypoint(a, now) {
  const target = { x: state.player.x, y: state.player.y };
  if (!a.path || a.pathRoom !== state.room || now - (a.pathAt || 0) > 300) {
    a.path = alienPlanPath({ x: a.x, y: a.y }, target);
    a.pathAt = now;
    a.pathRoom = state.room;
  }
  while (a.path.length && Math.hypot(a.path[0].x - a.x, a.path[0].y - a.y) < 3) a.path.shift();
  return a.path[0] || null;
}

// Death: stagger, topple backward pivoting on the boots, lie still, then a
// red flash fades to black before the retry.
const CONTROL_DEATH_MS = 2600;
function drawControlDeath(time) {
  const d = state.controlDeath;
  if (!d) return false;
  const img = generatedArt.utilityVentPlayer;
  const t = Math.min(1, (performance.now() - d.start) / CONTROL_DEATH_MS);
  let angle = 0, shake = 0, lift = 0;
  if (t < .15) {
    shake = Math.sin(time * 60) * 3;
  } else if (t < .45) {
    const k = (t - .15) / .3;
    angle = -1.5 * k * k;
  } else {
    const k = Math.min(1, (t - .45) / .1);
    angle = -1.5;
    lift = Math.sin(k * Math.PI) * 6; // small bounce on impact
  }
  if (img.complete && img.naturalWidth) {
    const sw = img.naturalWidth / 4, sh = img.naturalHeight;
    const dw = 158, dh = 238, foot = dh * .93;
    ctx.save();
    ctx.translate(d.x + shake, d.y - lift);
    ctx.rotate(angle);
    ctx.drawImage(img, 3 * sw, 0, sw, sh, -dw / 2, -foot, dw, dh);
    ctx.restore();
  }
  // Red vignette, then fade out.
  ctx.save();
  const red = t > .4 ? Math.min(1, (t - .4) / .2) * (.35 + .1 * Math.sin(time * 6)) : 0;
  if (red > 0) {
    const g = ctx.createRadialGradient(480, 320, 120, 480, 320, 560);
    g.addColorStop(0, "rgba(120,0,0,0)");
    g.addColorStop(1, `rgba(150,0,10,${red})`);
    ctx.fillStyle = g;
    ctx.fillRect(0, 0, 960, 640);
  }
  if (t > .75) {
    ctx.fillStyle = `rgba(0,0,0,${Math.min(1, (t - .75) / .25)})`;
    ctx.fillRect(0, 0, 960, 640);
  }
  ctx.restore();
  return true;
}

function drawControlAlien(time) {
  const a = state.controlAlien;
  const img = generatedArt.controlAlienSheet;
  if (!a || !(img.complete && img.naturalWidth > 0)) return;
  const C = CONTROL_ALIEN_CELL;
  const row = CONTROL_ALIEN_ROWS[a.facing];
  // Slow creeping gait; frozen mid-lunge while grabbing.
  const frame = a.caughtAt ? 1 : Math.floor(time * (a.emerging ? 9 : 4)) % 3;
  const w = C.w * CONTROL_ALIEN_SCALE, h = C.h * CONTROL_ALIEN_SCALE;
  // Feet sit near the bottom of each cell; idle breathing once it stops.
  const breathe = a.emerging ? 0 : Math.sin(time * 3) * 1.5;
  ctx.save();
  ctx.fillStyle = "rgba(0,0,0,.35)";
  ctx.beginPath();
  ctx.ellipse(a.x, a.y - 4, w * .3, 9, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.drawImage(img, frame * C.w, row * C.h, C.w, C.h, a.x - w / 2, a.y - h * .92 + breathe, w, h);
  ctx.restore();
}


// ---------- Room links for the corridor route (Room 2 <-> Room 6) ----------
function enterBreachFromHallway() {
  state.room = "breachedHallway";
  state.breachLevel = "upper";
  state.hover = null;
  Object.assign(state.player, { x: 142, y: 334, tx: 142, ty: 334, facing: "right", forcedFacing: null, currentDone: null, path: [] });
  playSfx("whoosh");
  setLog("You step through the secured corridor into the breached hallway.");
  updateUI();
}

function enterHallwayFromBreach() {
  state.room = "hallway";
  state.hover = null;
  state.onLadder = false;
  state.hallRightDoorOpen = true;
  Object.assign(state.player, { x: 880, y: 472, tx: 880, ty: 472, facing: "left", forcedFacing: null, currentDone: null, path: [] });
  playSfx("whoosh");
  setLog(state.chaseActive ? "Back in the crew corridor. The airlock is to the left. Run!" : "You step back into the crew corridor.");
  updateUI();
}

// ---------- Room-to-room chase ----------
// Once the crystal is taken the creature follows the player through every
// door. It reappears at the doorway the player used, a few seconds behind,
// then keeps creeping. Getting caught restarts the escape in Room 8.
function chaseFollowDelay() {
  const a = state.controlAlien;
  if (!a || a.caughtAt) return 3200;
  // The farther behind it was, the longer it takes to reach the door.
  const d = Math.hypot(a.x - state.chaseExitX, a.y - state.chaseExitY);
  return Math.max(2200, Math.min(7000, d / CONTROL_ALIEN_CREEP_SPEED * 1000 * .45));
}

function updateChase() {
  if (!state.chaseActive) return;
  const now = performance.now();
  if (state.chasePlayerRoom !== state.room) {
    // Player went through a door: the creature follows to the same spot.
    const prevPending = state.chasePending;
    const at = Math.max(now + chaseFollowDelay(), prevPending ? prevPending.at + 2000 : 0);
    state.chasePending = { room: state.room, x: state.player.x, y: state.player.y, at };
    state.controlAlien = null;
    state.chasePlayerRoom = state.room;
  }
  state.chaseExitX = state.player.x;
  state.chaseExitY = state.player.y;
  const p = state.chasePending;
  if (p && !state.controlAlien && p.room === state.room && now >= p.at) {
    state.controlAlien = { room: state.room, x: p.x, y: p.y, tx: p.x, ty: p.y, start: now, last: now, emerging: false, facing: state.player.x < p.x ? "left" : "right", caughtAt: 0 };
    state.chasePending = null;
    playAlienScream(1.05, .85);
    popComic("SKREEE!", p.x, Math.max(80, p.y - 140), "#e7a0ff");
    setLog("It came through the door after you!");
  }
  if (state.room !== "controlRoom") updateControlAlien();
}

function drawChaseOverlay(time) {
  // Room 8 draws the creature itself (with depth sorting).
  if (state.room === "controlRoom") return;
  // The hallway draws the creature itself so it passes behind the robot and trash can.
  if (state.room !== "hallway" && state.controlAlien && state.controlAlien.room === state.room) drawControlAlien(time);
  drawControlDeath(time);
  drawEscapeEnding();
}

// ---------- Escape ending (Room 1 outer hatch) ----------
function escapeShip() {
  state.chaseActive = false;
  state.chasePending = null;
  state.controlAlien = null;
  state.escapeEndingStart = performance.now();
  state.player.path = [];
  playSfx("whoosh");
  setLog("You burst through the outer hatch with the power crystal. You made it out!");
  updateUI();
}

function drawEscapeEnding() {
  if (!state.escapeEndingStart) return;
  const age = performance.now() - state.escapeEndingStart;
  const t = Math.min(1, age / 1500);
  ctx.save();
  ctx.fillStyle = `rgba(4,8,14,${.88 * t})`;
  ctx.fillRect(0, 0, 960, 640);
  ctx.textAlign = "center";
  // Title
  ctx.globalAlpha = t;
  ctx.fillStyle = "#9ff5e8";
  ctx.shadowColor = "rgba(120,245,255,.8)";
  ctx.shadowBlur = 18;
  ctx.font = "700 46px system-ui, sans-serif";
  ctx.fillText("ESCAPED", 480, 200);
  ctx.shadowBlur = 0;
  // Story lines fade in one after another.
  const lines = [
    "The outer hatch slams shut as the creature's shriek echoes through the hull.",
    "You tumble out onto the misty surface of the planet, lungs burning,",
    "the Power Crystal pulsing warm and violet in your hands.",
    "",
    "Behind you, the Silent Vessel goes dark for good.",
    "Its heart is yours now. Take it and head towards the alien Homeworld."
  ];
  ctx.font = "500 19px system-ui, sans-serif";
  lines.forEach((line, i) => {
    const la = Math.max(0, Math.min(1, (age - 1200 - i * 700) / 700));
    if (!line || la <= 0) return;
    ctx.globalAlpha = la;
    ctx.fillStyle = i >= 4 ? "#f3d9ff" : "#d7e6f0";
    ctx.fillText(line, 480, 262 + i * 32);
  });
  const done = Math.max(0, Math.min(1, (age - 1200 - lines.length * 700) / 800));
  if (done > 0) {
    ctx.globalAlpha = done;
    ctx.fillStyle = "#7fe0c8";
    ctx.font = "700 14px system-ui, sans-serif";
    ctx.fillText("STAGE 4 COMPLETE", 480, 490);
    // Continue to Stage 5 (click)
    ctx.globalAlpha = done * (.55 + .45 * Math.sin(performance.now() / 250));
    ctx.fillStyle = "#9ff5e8";
    ctx.beginPath(); ctx.moveTo(468, 518); ctx.lineTo(496, 534); ctx.lineTo(468, 550); ctx.closePath(); ctx.fill();
  }
  ctx.restore();
}

// Caught anywhere: Room 8 goes back to exactly how it was when the player
// first walked in. Field up, crystal in its chamber, power cell back in the
// pack (not seated), tuner and screens reset. Everything else the player had
// before entering Room 8 is kept.
function resetControlRoomAfterDeath() {
  clearTimeout(controlAlienTimer);
  clearTimeout(controlRadarTimer);
  state.room = "controlRoom";
  state.breachLevel = "upper";
  state.hover = null;
  state.selected = null;
  state.biomatterHorror = null;
  state.biomatterReadout = null;
  state.reactionUntil = 0;
  // Room 8 progress
  state.controlCoreSeated = false;
  state.tunerOpen = false;
  state.tuner = null;
  state.controlCrystalReleased = false;
  state.controlShatterStart = 0;
  state.controlCrystalCollected = false;
  state.controlRadarPokeStart = state.controlRadarLitAt = 0;
  state.controlWallRadarPokeStart = state.controlWallRadarLitAt = 0;
  // Chase off until the crystal is taken again
  state.chaseActive = false;
  state.chasePending = null;
  state.chasePlayerRoom = null;
  state.controlAlien = null;
  // Inventory as it was on entry: crystal out, power cell back in.
  state.inventory = state.inventory.filter(id => id !== "powerCrystal");
  if (!state.inventory.includes("powerCell")) state.inventory.push("powerCell");
  Object.assign(state.player, { x: 150, y: 400, tx: 150, ty: 400, path: [], currentDone: null, forcedFacing: null, facing: "right" });
  setLog("You come to at the chamber entrance. The crystal hums behind its field again.");
  updateUI();
}

function drawGeneratedControlRoom(time) {
  const bg = generatedArt.controlBackground;
  if (bg.complete && bg.naturalWidth) ctx.drawImage(bg, 0, 0, 960, 640);
  else {
    ctx.fillStyle = "#120e1e";
    ctx.fillRect(0, 0, 960, 640);
  }
  // Field down: cross-fade to the full field-off plate (its window view is
  // painted separately, so it is drawn full-frame, before any overlays).
  const off = generatedArt.controlBackgroundFieldOff;
  if (state.controlCrystalReleased && off.complete && off.naturalWidth) {
    const k = state.controlShatterStart ? Math.min(1, (performance.now() - state.controlShatterStart) / (CONTROL_SHATTER_MS * .45)) : 1;
    ctx.save();
    ctx.globalAlpha = k;
    ctx.drawImage(off, 0, 0, 960, 640);
    ctx.restore();
  }
  updateTuner();
  drawRadarScreenFlash(time);
  drawControlRoomDetails(time);
  drawBiomatterReadout();
  if (state.hover && !state.tunerOpen) drawGeneratedSpriteHighlight(state.hover.id);
  updateControlAlien();
  const alienInFront = state.controlAlien && state.controlAlien.y > state.player.y;
  if (!alienInFront) drawControlAlien(time);
  if (!state.controlDeath && !drawBiomatterHorror(time)) drawPlayer(time);
  if (alienInFront) drawControlAlien(time);
  if (state.controlDeath) drawControlDeath(time);
  // (player drawn above; the startled pose replaces it while active)
  drawControlShatter();
  if (state.tunerOpen) drawTuner(time);
  else drawHover();
}

function collectBrokenCanisterGoo() {
  state.player.facing = "up";
  if (state.biomatterGooCollected) {
    setLog("Only glass shards and a faint green stain are left.");
    return;
  }
  state.biomatterGooCollected = true;
  addItem("coldGoo");
  playSfx("pop");
  setLog("You tip the cracked canister upright and scoop the spill back inside. The goo is cold and runny. Not sticky at all.");
}

function inspectBreachedLeftPanel() {
  state.player.facing = "up";
  if (useSelectedOn("breachLeftPanel")) return;
  setLog("The panel is dead. Its power-cell slot is empty.");
}

function inspectBreachedHangingPipe() {
  state.player.facing = "right";
  if (useSelectedOn("breachHangingPipe")) return;
  reactNope();
  setLog("A long pipe hangs loose over the gap. Too far out to reach by hand.");
}

// Knock the dangling pipe loose with the rod: it tears free of the ceiling
// socket, swings down and lands across the gap (loose until glued).
const BREACH_PIPE_FALL_MS = 1500;
function beginBreachPipeFall() {
  state.player.path = [];
  state.player.currentDone = null;
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  state.player.facing = "right";
  state.player.forcedFacing = "right";
  state.hover = null;
  state.breachPipeFall = { start: performance.now(), clanked: false };
  playSfx("clank");
}

function updateBreachPipeFall() {
  const f = state.breachPipeFall;
  const t = (performance.now() - f.start) / BREACH_PIPE_FALL_MS;
  if (!f.clanked && t > .62) {
    f.clanked = true;
    playSfx("clank");
  }
  if (t < 1) return;
  state.breachPipeFall = null;
  state.breachedBridgeExtended = true;
  state.player.forcedFacing = null;
  state.selected = null;
  setLog("You hook the rod behind the pipe and yank. It tears out of the ceiling and crashes down across the gap. It rocks when you nudge it.");
  updateUI();
}

function inspectBreachedBridge() {
  state.player.facing = "right";
  if (useSelectedOn("breachBridge")) return;
  if (!state.breachedBridgeLatched) reactNope();
  setLog(state.breachedBridgeLatched
    ? "Hardened biomatter glues the pipe to both ledges. It looks solid enough to cross."
    : "The pipe spans the gap, but it rolls when you touch it. It needs to be stuck down.");
}

function collectBiomatterRod() {
  if (state.biomatterRodCollected) return;
  state.biomatterRodCollected = true;
  addItem("rod");
  playSfx("pop");
  setLog("You pick up the steel rod lying by the vent. Long enough to reach across a gap.");
}

function collectSpecimenPole() {
  if (state.biomatterPoleCollected) {
    setLog("The magnetic clamp is empty now.");
    return;
  }
  state.biomatterPoleCollected = true;
  addItem("specimenPole");
  playSfx("pop");
  setLog("You take the magnetic sample clamp off the bench.");
}

function collectBreachedPowerCell() {
  // The cell sits on the lower floor, which has no route yet.
  if (state.breachLevel !== "lower") {
    reactNope();
    setLog("It's down on the lower floor. You can't reach it from up here.");
    return;
  }
  state.breachedPowerCellCollected = true;
  state.player.facing = "down";
  addItem("powerCell");
  playSfx("pop");
  setLog("You pocket the bridge power cell. It may be useful for restoring a crossing device.");
}

// Heating the goo: the player holds the loaded specimen pole out over the
// flames. Pole reaches out, goo bubbles and darkens with steam, pole returns.
const BREACH_HEAT_MS = 3000;
const BREACH_HEAT_EXTEND = .16;   // fraction of the timeline spent reaching
const BREACH_HEAT_RETRACT = .84;  // fraction where the pole starts coming back
const BREACH_FIRE_TIP = { x: 272, y: 286 };

function beginBreachHeatAction() {
  state.player.path = [];
  state.player.currentDone = null;
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  state.player.facing = "left";
  state.player.forcedFacing = "left";
  state.hover = null;
  state.breachHeatAction = { start: performance.now(), sizzled: false };
  playSfx("kzzt");
}

function updateBreachHeatAction() {
  const a = state.breachHeatAction;
  const t = (performance.now() - a.start) / BREACH_HEAT_MS;
  if (!a.sizzled && t > .45) {
    a.sizzled = true;
    playSfx("kzzt");
  }
  if (t < 1) return;
  state.breachHeatAction = null;
  state.player.forcedFacing = null;
  removeItem("coldGooPole");
  state.inventory.push("hotGooClamp");
  state.selected = "hotGooClamp";
  playCombineTwinkle();
  setLog("You hold the clamp over the flames. The goo bubbles, darkens, and turns tacky.");
  updateUI();
}

function lerpColor(a, b, t) {
  return `rgb(${a.map((v, i) => Math.round(v + (b[i] - v) * t)).join(",")})`;
}

function drawBreachHeatAction(time) {
  const a = state.breachHeatAction;
  if (!a || state.room !== "breachedHallway") return;
  const now = performance.now();
  const t = Math.min(1, (now - a.start) / BREACH_HEAT_MS);
  const p = state.player;
  const hand = { x: p.x - 16, y: p.y - 44 };
  // Reach out, hold (with a small tremble), then pull back.
  let reach;
  if (t < BREACH_HEAT_EXTEND) reach = t / BREACH_HEAT_EXTEND;
  else if (t > BREACH_HEAT_RETRACT) reach = 1 - (t - BREACH_HEAT_RETRACT) / (1 - BREACH_HEAT_RETRACT);
  else reach = 1;
  reach = reach * reach * (3 - 2 * reach);
  const hold = t >= BREACH_HEAT_EXTEND && t <= BREACH_HEAT_RETRACT;
  const tremble = hold ? Math.sin(time * 40) * 1.2 : 0;
  const tip = {
    x: hand.x + (BREACH_FIRE_TIP.x - hand.x) * reach,
    y: hand.y + (BREACH_FIRE_TIP.y - hand.y) * reach + tremble
  };
  // How cooked the goo is: 0 cold, 1 tacky.
  const heat = Math.max(0, Math.min(1, (t - BREACH_HEAT_EXTEND) / (BREACH_HEAT_RETRACT - BREACH_HEAT_EXTEND)));

  ctx.save();
  // Flames flare up around the goo while it's held in them.
  if (hold) {
    const flare = .35 + .25 * Math.sin(time * 18);
    const g = ctx.createRadialGradient(BREACH_FIRE_TIP.x, BREACH_FIRE_TIP.y + 10, 2, BREACH_FIRE_TIP.x, BREACH_FIRE_TIP.y + 10, 46);
    g.addColorStop(0, `rgba(255,190,90,${flare})`);
    g.addColorStop(1, "rgba(255,120,40,0)");
    ctx.fillStyle = g;
    ctx.fillRect(BREACH_FIRE_TIP.x - 50, BREACH_FIRE_TIP.y - 40, 100, 100);
  }
  // Pole shaft.
  ctx.lineCap = "round";
  ctx.strokeStyle = "#2a2230";
  ctx.lineWidth = 7;
  ctx.beginPath();
  ctx.moveTo(hand.x + 6, hand.y + 3);
  ctx.lineTo(tip.x, tip.y);
  ctx.stroke();
  ctx.strokeStyle = "#8d8f9e";
  ctx.lineWidth = 4;
  ctx.beginPath();
  ctx.moveTo(hand.x + 6, hand.y + 3);
  ctx.lineTo(tip.x, tip.y);
  ctx.stroke();
  // Cyan band near the grip.
  const gx = hand.x + (tip.x - hand.x) * .12;
  const gy = hand.y + (tip.y - hand.y) * .12;
  ctx.fillStyle = "#5aece4";
  ctx.beginPath();
  ctx.arc(gx, gy, 2.5, 0, Math.PI * 2);
  ctx.fill();
  // Clamp jaws.
  ctx.strokeStyle = "#4b4553";
  ctx.lineWidth = 3;
  ctx.beginPath();
  ctx.arc(tip.x, tip.y, 9, Math.PI * .6, Math.PI * 1.4);
  ctx.stroke();
  // Goo blob: pale runny green -> dark tacky olive, bubbling as it heats.
  const wobble = 1 + Math.sin(time * 14) * .06 * (1 - heat * .5);
  const r = 10 * wobble;
  ctx.fillStyle = lerpColor([170, 238, 90], [104, 150, 34], heat);
  ctx.shadowBlur = 10;
  ctx.shadowColor = `rgba(170,240,90,${.7 - heat * .4})`;
  ctx.beginPath();
  ctx.ellipse(tip.x, tip.y + 1, r, r * .85, 0, 0, Math.PI * 2);
  ctx.fill();
  ctx.shadowBlur = 0;
  ctx.fillStyle = `rgba(230,255,170,${.75 - heat * .45})`;
  ctx.beginPath();
  ctx.ellipse(tip.x - 2.5, tip.y - 2, 2.4, 1.6, 0, 0, Math.PI * 2);
  ctx.fill();
  // Drip while still cold.
  if (heat < .5) {
    const dripT = (time * 1.6) % 1;
    ctx.fillStyle = `rgba(170,238,90,${(1 - dripT) * (1 - heat * 2)})`;
    ctx.beginPath();
    ctx.ellipse(tip.x + 1, tip.y + 8 + dripT * 14, 1.8, 2.6, 0, 0, Math.PI * 2);
    ctx.fill();
  }
  if (hold) {
    // Bubbles popping on the surface.
    for (let i = 0; i < 4; i++) {
      const bt = (time * (1.4 + i * .3) + i * .27) % 1;
      const ang = i * 1.7 + time;
      const bx = tip.x + Math.cos(ang) * 5;
      const by = tip.y + Math.sin(ang) * 3 - bt * 3;
      ctx.strokeStyle = `rgba(210,255,140,${(1 - bt) * .8})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.arc(bx, by, 1 + bt * 2, 0, Math.PI * 2);
      ctx.stroke();
    }
    // Steam wisps rising off the goo.
    for (let i = 0; i < 5; i++) {
      const st = (time * .9 + i / 5) % 1;
      const sx = tip.x - 6 + i * 3 + Math.sin(st * 6 + i) * 4;
      const sy = tip.y - 8 - st * 38;
      ctx.fillStyle = `rgba(220,225,235,${(1 - st) * .28 * Math.min(1, heat * 2)})`;
      ctx.beginPath();
      ctx.arc(sx, sy, 3 + st * 6, 0, Math.PI * 2);
      ctx.fill();
    }
    // A few sparks kicked up by the sizzle.
    for (let i = 0; i < 3; i++) {
      const kt = (time * 2.2 + i * .33) % 1;
      ctx.fillStyle = `rgba(255,210,110,${1 - kt})`;
      ctx.fillRect(tip.x - 8 + i * 8 + Math.sin(i * 3 + kt * 4) * 5, tip.y + 6 - kt * 22, 2, 2);
    }
  }
  ctx.restore();
}

function inspectBreachedFire() {
  state.player.facing = "up";
  if (useSelectedOn("breachFire")) return;
  playSfx("kzzt");
  setLog("The wreckage is still burning. Too hot to touch.");
}

function returnToHallwayVent() {
  state.player.facing = "right";
  beginUtilityAction("ventSwipe", 2350, { startX: state.player.x, startY: state.player.y });
  playSfx("kzzt");
}

function beginUtilityAction(type, duration, extra = {}) {
  if (state.utilityAction) return;
  state.player.path = [];
  state.player.currentDone = null;
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  state.utilityAction = { type, start: performance.now(), duration, ...extra };
  state.hover = null;
}

function beginUtilityPickup(item) {
  beginUtilityAction("pickup", 900, { item });
  state.player.facing = item === "hose" || item === "cleanRag" ? "left" : "right";
  playSfx("pop");
}

function interactUtilityToolkit() {
  if (!state.utilityToolkitOpen) {
    state.utilityToolkitOpen = true;
    state.player.facing = "right";
    playSfx("clank");
    return;
  }
  if (!state.utilityWrenchCollected) {
    beginUtilityPickup("wrench");
    return;
  }
  reactNope();
}

function triggerUtilitySlimeBox() {
  if (state.utilitySlimeBoxFallen) return;
  state.utilitySlimeBoxFallen = true;
  state.player.facing = "up";
  beginUtilityAction("slime", 2700);
  playSfx("clank");
}

function pullUtilityWire() {
  if (state.selected) {
    if (useSelectedOn("utilityWire")) return;
  }
  if (state.utilityCableRouted) {
    playSfx("ding");
    setLog("The tied hose holds the cable steady inside the opened blue panel.");
    return;
  }
  state.player.facing = "right";
  beginUtilityAction("wire", 1750);
  playSfx("kzzt");
}

function interactUtilityDoorButton() {
  if (state.selected) {
    if (useSelectedOn("utilityDoorButton")) return;
  }
  if (state.utilityCableRouted && !state.utilityDoorOpen) {
    state.player.facing = "up";
    beginUtilityAction("utilityDoorOpen", 1200);
    playSfx("ding");
    setLog("The tied hose holds. The blue panel wakes up and the center door opens.");
    return;
  }
  if (state.utilityDoorOpen) {
    playSfx("ding");
    setLog("The center utility door is open.");
    return;
  }
  if (state.utilityDoorPanelOpen) {
    playSfx("kzzt");
    setLog("The opened blue panel hums faintly. It needs the cable rerouted into it.");
    return;
  }
  reactNope();
  setLog("The blue panel will not budge by hand.");
}

function shakeUtilityEmptyBox() {
  state.player.facing = "down";
  beginUtilityAction("emptyBox", 1900);
  playSfx("clank");
}

function hallwayHotspotList() {
  return [
    { id: "hallToneLeft", label: "Low Tone Button", x: 240, y: 298, w: 36, h: 38, action: () => playHallwayTone("low") },
    { id: "hallToneMiddle", label: "Middle Tone Button", x: 397, y: 268, w: 42, h: 43, action: () => playHallwayTone("middle") },
    { id: "hallToneRight", label: "High Tone Button", x: 777, y: 224, w: 42, h: 43, action: () => playHallwayTone("high") },
    { id: "hallLeftDoor", label: "Airlock Door", x: 0, y: 118, w: 105, h: 330, action: returnToAirlock },
    { id: "hallDoorA", label: state.hallDoorAOpen ? "Open Washroom Door" : "Battered Crew Door", x: 264, y: 176, w: 126, h: 246, action: () => state.hallDoorAOpen ? enterBathroomFromHallway() : inspectHallwayProp("doorA") },
    { id: "hallDoorB", label: state.utilityDoorOpen ? "Open Utility Door" : "Pristine Utility Door", x: 608, y: 176, w: 126, h: 246, action: () => state.utilityDoorOpen ? enterUtilityFromHallwayDoor() : inspectHallwayProp("doorB") },
    { id: "hallKeypad", label: "Door Keypad", x: 842, y: 274, w: 42, h: 72, action: openHallwayKeypad },
    { id: "hallRightDoor", label: state.hallRightDoorOpen ? "Open Corridor Passage" : state.keypadUnlocked ? "Unlocked Corridor Door" : "Secured Corridor Door", x: 852, y: 116, w: 108, h: 334, action: openHallwayRightDoor },
    { id: "hallTrash", label: "Alien Trash Can", x: 171, y: 340, w: 92, h: 150, action: () => state.hallwayRagCollected ? inspectHallwayProp("trash") : beginHallwayPickup("rag") },
    { id: "hallPaper", label: "Crooked Paper Art", x: 136, y: 184, w: 108, h: 140, action: () => inspectHallwayProp("paper") },
    { id: "hallCleaner", label: "Round Cleaning Gadget", x: state.hallwayCleanerX - 48, y: 362, w: 96, h: 118, action: interactHallwayCleaner },
    { id: "hallRagShreds", label: "Rag Shreds", x: state.hallwayRagShredsX - 42, y: 444, w: 84, h: 34, visible: () => state.hallwayRagShredsAvailable && !state.hallwayRagShredsCollected, action: () => beginHallwayPickup("ragShreds") },
    { id: "hallMirror", label: "Alien Mirror", x: 438, y: 164, w: 112, h: 206, action: () => inspectHallwayProp("mirror") },
    { id: "hallVase", label: "Table Vase", x: 528, y: 288, w: 62, h: 84, action: () => state.hallwayDirtCollected ? inspectHallwayProp("vase") : beginHallwayPickup("dirt") },
    { id: "hallVent", label: state.hallwayRopeInstalled ? "Makeshift Rope" : "High Wall Vent", x: 684, y: 28, w: 112, h: state.hallwayRopeInstalled ? 450 : 128, action: interactHallwayVent }
  ].filter(h => !h.visible || h.visible());
}

function bathroomHotspotList() {
  return [
    { id: "bathroomExit", label: "Crew Hallway", x: 0, y: 155, w: 132, h: 300, action: returnFromBathroomToHallway },
    { id: "bathroomCrawlspace", label: "Open Crawlspace", x: 578, y: 62, w: 82, h: 194, visible: () => state.bathroomSecretPanelOpen, action: enterCrawlspaceFromBathroom },
    { id: "bathroomFaucetLeft", label: state.bathroomFaucets[0] ? "Turn Off Left Faucet" : "Turn On Left Faucet", x: 241, y: 190, w: 34, h: 47, action: () => toggleBathroomFaucet(0) },
    { id: "bathroomFaucetMiddle", label: state.bathroomFaucets[1] ? "Turn Off Middle Faucet" : "Turn On Middle Faucet", x: 333, y: 188, w: 34, h: 47, action: () => toggleBathroomFaucet(1) },
    { id: "bathroomFaucetRight", label: state.bathroomFaucets[2] ? "Turn Off Right Faucet" : "Turn On Right Faucet", x: 426, y: 185, w: 34, h: 47, action: () => toggleBathroomFaucet(2) },
    { id: "bathroomBowl", label: "Alien Bowl", x: 709, y: 105, w: 61, h: 43, visible: () => state.bathroomLeftDoorOpen && !state.bathroomBowlCollected, action: collectBathroomBowl },
    { id: "bathroomRightToilet", label: "Filthy Toilet", x: 852, y: 206, w: 108, h: 116, visible: () => state.bathroomRightDoorOpen, action: inspectBathroomRightToilet },
    { id: "bathroomMud", label: "Floor Mess", x: 818, y: 292, w: 140, h: 82, visible: () => state.bathroomRightDoorOpen && !state.bathroomMudCleaned, action: reactDisgust },
    { id: "bathroomLeftStall", label: state.bathroomLeftDoorOpen ? "Open Left Stall" : "Left Stall", x: 661, y: 23, w: 160, h: 322, action: () => toggleBathroomStall("left") },
    { id: "bathroomRightStall", label: state.bathroomRightDoorOpen ? "Open Right Stall" : "Right Stall", x: 824, y: 35, w: 136, h: 325, action: () => toggleBathroomStall("right") },
    // Position comes from the sprite layout so the hotspot, the hover outline
    // and the drawn cart cannot drift apart when the cart is moved.
    { id: "bathroomJanitorCart", label: "Janitor Cart", ...bathroomCleaningSpriteRect("bathroomJanitorCart"), action: inspectBathroomJanitorCart },
    { id: "bathroomTrash", label: "Purple Trash Can", ...bathroomCleaningSpriteRect("bathroomTrash"), action: inspectBathroomTrash }
  ].filter(h => !h.visible || h.visible());
}

function crawlspaceHotspotList() {
  return [
    { id: "crawlspaceExit", label: "Alien Washroom", x: 52, y: 164, w: 132, h: 280, action: returnFromCrawlspaceToBathroom },
    { id: "crawlspaceMirrorPaper", label: "Paper Scrap", ...crawlspaceMirrorPaperHotspotRect(), action: beginCrawlspaceMirrorPaperPickup },
    { id: "crawlspacePipeButton", label: "Red Button", ...crawlspacePipeButtonHotspotRect(), action: pressCrawlspacePipeButton }
  ].filter(h => !h.visible || h.visible());
}

function pressCrawlspacePipeButton() {
  if (state.crawlspacePipeButtonPressStart) return;
  state.crawlspacePipeButtonPressStart = performance.now();
  state.crawlspaceSteamWhooshPlayed = false;
  state.hover = null;
  state.player.facing = "right";
  playSfx("boop");
  setLog("The red button depresses with a solid click. Something rattles inside the pipe.");
}

function inspectBathroomJanitorCart() {
  if (state.bathroomMopAction) return;
  if (!state.bathroomMudCleaned) {
    if (!state.bathroomRightDoorOpen) {
      reactNope();
      setLog("The astronaut raises both hands. Open the right stall before carrying that mop anywhere.");
      return;
    }
    state.bathroomMopAction = { phase: "wink", start: performance.now() };
    state.hover = null;
    state.player.path = [];
    state.player.currentDone = null;
    state.player.tx = state.player.x;
    state.player.ty = state.player.y;
    state.player.facing = "right";
    playSfx("clank");
    popComic("squeak!", 790, 468, "#f2c45b");
    setLog("Before taking the mop, the astronaut slowly turns toward... you.");
    return;
  }
  if (state.bathroomJanitorWinkStart) return;
  state.bathroomJanitorWinkStart = performance.now();
  state.hover = null;
  state.player.path = [];
  state.player.currentDone = null;
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  state.player.facing = "right";
  playSfx("clank");
  popComic("squeak!", 790, 468, "#f2c45b");
  setLog("You test the janitor cart. It squeaks, and the astronaut slowly turns toward... you.");
}

function inspectBathroomTrash() {
  beginCrawlspaceNotePickup();
}

function openHallwayRightDoor() {
  if (state.hallRightDoorOpen) {
    enterBreachFromHallway();
    return;
  }
  if (!state.keypadUnlocked) {
    reactNope();
    setLog("The secured corridor door refuses to move. Its keypad is still locked.");
    return;
  }
  state.hallRightDoorOpen = true;
  state.hallRightDoorOpenStart = performance.now();
  state.hover = null;
  state.player.facing = "up";
  playSfx("whoosh");
  setLog("The override takes hold. The corridor door retracts into the wall.");
  updateUI();
}

function enterBathroomFromHallway() {
  state.room = "bathroom";
  state.hover = null;
  Object.assign(state.player, { x: 105, y: 480, tx: 105, ty: 480, facing: "right", forcedFacing: null, currentDone: null, path: [] });
  playSfx("ding");
  updateUI();
}

function returnFromBathroomToHallway() {
  state.room = "hallway";
  state.hover = null;
  Object.assign(state.player, { x: 326, y: 472, tx: 326, ty: 472, facing: "down", forcedFacing: null, currentDone: null, path: [] });
  playSfx("ding");
  updateUI();
}

// The crawlspace walkway is a narrow ledge. Its painted front edge is the
// bright line at y=466, with the flat top surface ending around y=458; below
// 466 is the ledge's front face and then the dark drop. player.y is the
// sprite's feet, so the walk line has to sit above that edge or the boots
// hang over the lip.
const CRAWLSPACE_WALK_Y = 458;

function enterCrawlspaceFromBathroom() {
  if (!state.bathroomSecretPanelOpen) return;
  state.room = "crawlspace";
  state.hover = null;
  Object.assign(state.player, { x: 190, y: CRAWLSPACE_WALK_Y, tx: 190, ty: CRAWLSPACE_WALK_Y, facing: "right", forcedFacing: null, currentDone: null, path: [] });
  playSfx("whoosh");
  setLog("You squeeze through the hidden panel into a cramped maintenance crawlspace.");
  updateUI();
}

function returnFromCrawlspaceToBathroom() {
  state.room = "bathroom";
  state.hover = null;
  state.crawlspaceNoteViewing = false;
  state.crawlspaceNotePickupStart = 0;
  state.crawlspaceNoteReturnStart = 0;
  state.crawlspaceMirrorPaperViewing = false;
  state.crawlspaceMirrorPaperPickupStart = 0;
  state.crawlspaceMirrorPaperReturnStart = 0;
  Object.assign(state.player, { x: 620, y: 390, tx: 620, ty: 390, facing: "down", forcedFacing: null, currentDone: null, path: [] });
  playSfx("whoosh");
  setLog("You slip back through the open wall panel into the washroom.");
  updateUI();
}

const CRAWLSPACE_NOTE_PICKUP_MS = 1400;
const CRAWLSPACE_NOTE_ZOOM_DELAY_MS = 780;
const CRAWLSPACE_NOTE_RETURN_MS = 900;

function beginCrawlspaceNotePickup() {
  if (state.crawlspaceNotePickupStart || state.crawlspaceNoteViewing || state.crawlspaceNoteReturnStart) return;
  state.crawlspaceNotePickupStart = performance.now();
  state.crawlspaceNoteViewing = false;
  state.hover = null;
  state.player.path = [];
  state.player.currentDone = null;
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  state.player.facing = "right";
  playSfx("pop");
  setLog("You pull a stained note from the purple trash can.");
}

function closeCrawlspaceNote() {
  if (!state.crawlspaceNoteViewing) return false;
  state.crawlspaceNoteViewing = false;
  state.crawlspaceNoteReturnStart = performance.now();
  playSfx("boop");
  setLog("You lower the note and tuck it back into the purple trash can.");
  updateUI();
  return true;
}

const CRAWLSPACE_MIRROR_PAPER_PICKUP_MS = 1400;
const CRAWLSPACE_MIRROR_PAPER_ZOOM_DELAY_MS = 780;
const CRAWLSPACE_MIRROR_PAPER_RETURN_MS = 900;

function beginCrawlspaceMirrorPaperPickup() {
  if (state.crawlspaceMirrorPaperPickupStart || state.crawlspaceMirrorPaperViewing || state.crawlspaceMirrorPaperReturnStart) return;
  state.crawlspaceMirrorPaperPickupStart = performance.now();
  state.crawlspaceMirrorPaperViewing = false;
  state.hover = null;
  state.player.path = [];
  state.player.currentDone = null;
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  state.player.facing = "up";
  playSfx("pop");
  setLog("You lift the face-down paper scrap from the crawlspace table.");
}

function closeCrawlspaceMirrorPaper() {
  if (!state.crawlspaceMirrorPaperViewing) return false;
  state.crawlspaceMirrorPaperViewing = false;
  state.crawlspaceMirrorPaperReturnStart = performance.now();
  playSfx("boop");
  setLog("You lower the numbered scrap and turn it face-down again.");
  updateUI();
  return true;
}

const BATHROOM_TOILET_ACTION_MS = 1500;
const BATHROOM_TOILET_STALL_ENTRY = { x: 780, y: 405 };
const BATHROOM_TOILET_STALL_BOWL = { x: 770, y: 350 };

function bathroomToiletReachReady() {
  return !state.bathroomToiletLeverPulled
    && state.crawlspaceNoteCollected
    && state.bathroomMudCleaned
    && hasItem("cleanRag");
}

function inspectBathroomRightToilet() {
  if (state.bathroomToiletLeverPulled) {
    playSfx("boop");
    setLog("The hidden toilet switch is locked in place, and the wall panel is already open.");
    return;
  }
  if (!state.crawlspaceNoteCollected) {
    reactDisgust();
    playSfx("squish");
    setLog("The right toilet is revolting. You are not searching it without a very good reason.");
    return;
  }
  if (!state.bathroomMudCleaned) {
    reactNope();
    setLog("The note points inside the toilet, but the floor mess has to be cleaned before you can reach the bowl safely.");
    return;
  }
  if (!hasItem("cleanRag")) {
    reactDisgust();
    playSfx("squish");
    setLog("The note says the lever is in there, but you need something clean to protect your glove.");
    return;
  }

  removeItem("cleanRag");
  state.bathroomToiletAction = { start: performance.now(), duration: BATHROOM_TOILET_ACTION_MS, gruntPlayed: false };
  state.hover = null;
  state.player.path = [];
  state.player.currentDone = null;
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  state.player.facing = "right";
  playSfx("squish");
  setLog("You wrap your glove in the clean rag and reach into the filthy toilet.");
  updateUI();
}

function toggleBathroomStall(side) {
  const key = side === "left" ? "bathroomLeftDoorOpen" : "bathroomRightDoorOpen";
  state[key] = !state[key];
  playSfx(state[key] ? "ding" : "clank");
}

function toggleBathroomFaucet(index) {
  state.bathroomFaucets[index] = !state.bathroomFaucets[index];
  playSfx(state.bathroomFaucets[index] ? "water" : "boop");
  const allOn = state.bathroomFaucets.every(Boolean);
  if (allOn && !state.bathroomMirrorCodeRevealed && !state.bathroomAllFaucetsStart) {
    state.bathroomAllFaucetsStart = performance.now();
  } else if (!allOn && !state.bathroomMirrorCodeRevealed) {
    // The three-second heat-up must be uninterrupted.
    state.bathroomAllFaucetsStart = 0;
    state.bathroomSteamRevealStart = 0;
  }
}

function collectBathroomBowl() {
  if (state.bathroomBowlCollected) return;
  state.bathroomBowlCollected = true;
  state.player.facing = "down";
  addItem("bowl");
  playSfx("pop");
}

const BATHROOM_SECRET_PANEL_MS = 1600;

function openBathroomSecretPanel() {
  if (state.bathroomSecretPanelOpen || state.bathroomSecretPanelStart) return;
  state.bathroomSecretPanelStart = performance.now();
  state.hover = null;
  state.player.forcedFacing = "up";
  state.player.path = [];
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  playSfx("clank");
  window.setTimeout(() => {
    if (state.bathroomSecretPanelStart) playSfx("whoosh");
  }, 280);
}

const HALLWAY_KEYPAD_CODE = "9733";

function keypadHotspotList() {
  const keys = ["1", "2", "3", "4", "5", "6", "7", "8", "9", "clear", "0", "enter"];
  const startX = 338;
  const startY = 214;
  const w = 78;
  const h = 62;
  const gapX = 22;
  const gapY = 16;
  const hotspots = keys.map((key, index) => {
    const col = index % 3;
    const row = Math.floor(index / 3);
    return {
      id: `keypad-${key}`,
      label: key === "clear" ? "Clear" : key === "enter" ? "Enter" : key,
      x: startX + col * (w + gapX),
      y: startY + row * (h + gapY),
      w,
      h,
      action: () => pressKeypadKey(key)
    };
  });
  hotspots.push({ id: "keypad-close", label: "Close", x: 614, y: 128, w: 32, h: 32, action: closeHallwayKeypad });
  return hotspots;
}

function openHallwayKeypad() {
  state.keypadOpen = true;
  state.keypadEntry = "";
  state.hover = null;
  state.player.facing = "right";
  playSfx("boop");
}

function closeHallwayKeypad() {
  state.keypadOpen = false;
  state.keypadEntry = "";
  state.hover = null;
}

function pressKeypadKey(key) {
  if (key === "clear") {
    state.keypadEntry = "";
    playSfx("kzzt");
    return;
  }
  if (key === "enter") {
    if (state.keypadEntry === HALLWAY_KEYPAD_CODE) {
      state.keypadUnlocked = true;
      playCombineTwinkle();
      state.keypadFeedbackUntil = performance.now() + 850;
      setTimeout(closeHallwayKeypad, 700);
    } else {
      state.keypadEntry = "";
      state.keypadFeedbackUntil = performance.now() + 600;
      playSfx("nope");
    }
    return;
  }
  if (state.keypadEntry.length < HALLWAY_KEYPAD_CODE.length) {
    state.keypadEntry += key;
    playSfx("boop");
  }
}

function switchToHallway() {
  state.room = "hallway";
  state.onLadder = false;
  state.hover = null;
  state.player.path = [];
  state.player.currentDone = null;
  state.player.forcedFacing = null;
  state.player.x = 72;
  state.player.y = 472;
  state.player.tx = 72;
  state.player.ty = 472;
  state.player.facing = "right";
  setLog("The airlock opens into a long crew corridor.");
  updateUI();
}

function enterHallway() {
  setPlayerPath([{ x: 930, y: 448, facing: "right", done: switchToHallway }]);
}

function returnToAirlock() {
  setPlayerPath([{
    x: 28,
    y: 472,
    facing: "left",
    done: () => {
      state.room = "airlock";
      state.hover = null;
      state.player.x = 884;
      state.player.y = 448;
      state.player.tx = 884;
      state.player.ty = 448;
      state.player.facing = "left";
      updateUI();
    }
  }]);
}

function spillHallwayDirt(x) {
  removeItem("dirt");
  state.selected = null;
  state.hallwayDirtSpilled = true;
  state.hallwayDirtX = Math.max(320, Math.min(690, x));
  state.hallwayCleanerMode = "approaching";
  state.hallwayCleanerTargetX = state.hallwayDirtX;
  playSfx("squish");
  setLog("The dirt scatters across the deck. The cleaning machine notices immediately.");
  updateUI();
}

function interactHallwayCleaner() {
  if (state.selected === "rag") {
    if (state.hallwayCleanerMode !== "wiping") {
      reactNope();
      setLog("The cleaner zips away from the rag. It needs to be distracted first.");
      return;
    }
    removeItem("rag");
    state.selected = null;
    state.hallwayCleanerMode = "jamming";
    state.hallwayCleanerActionStart = performance.now();
    playSfx("clank");
    setTimeout(() => playSfx("squish"), 260);
    setLog("The rag catches in the spinning brushes. The cleaner shudders and tears it apart.");
    updateUI();
    return;
  }
  if (state.hallwayCleanerMode === "wiping" || state.hallwayCleanerMode === "approaching" || state.hallwayCleanerMode === "jamming") {
    reactNope();
    return;
  }
  inspectHallwayProp("cleaner");
}

function interactHallwayVent() {
  if (state.selected === "ragShreds" && !state.hallwayRopeInstalled) {
    removeItem("ragShreds");
    state.selected = null;
    state.hallwayRopeTying = true;
    state.hallwayRopeTieStart = performance.now();
    state.player.facing = "down";
    state.player.forcedFacing = "down";
    state.player.path = [];
    state.player.currentDone = null;
    state.player.tx = state.player.x;
    state.player.ty = state.player.y;
    playSfx("squish");
    setLog("You begin knotting the torn strips together.");
    updateUI();
    return;
  }
  if (state.hallwayRopeInstalled) {
    state.hallwayVentClimbing = true;
    state.player.forcedFacing = "up";
    setPlayerPath([
      { x: 738, y: 472, facing: "up" },
      { x: 738, y: 128, facing: "up", done: switchToUtilityCloset }
    ]);
    playSfx("clank");
    return;
  }
  reactNope();
}

function switchToUtilityCloset() {
  state.room = "utility";
  state.hallwayVentClimbing = false;
  state.utilityEntryAnimating = true;
  state.utilityEntryStart = performance.now();
  state.hover = null;
  Object.assign(state.player, { x: 902, y: 172, tx: 902, ty: 172, facing: "down", forcedFacing: "down", currentDone: null, path: [] });
  setLog("You squeeze through the vent and drop into the utility closet.");
  updateUI();
}

function enterUtilityFromHallwayDoor() {
  if (!state.utilityDoorOpen) {
    reactNope();
    return;
  }
  state.room = "utility";
  state.hover = null;
  state.utilityEntryAnimating = false;
  Object.assign(state.player, {
    x: 456,
    y: 372,
    tx: 456,
    ty: 372,
    facing: "up",
    forcedFacing: null,
    currentDone: null,
    path: []
  });
  playSfx("ding");
  updateUI();
}

function returnFromUtilityToHallway() {
  setPlayerPath([
    {
      x: 456,
      y: 238,
      facing: "up",
      done: () => {
        state.room = "hallway";
        state.hover = null;
        Object.assign(state.player, {
          x: 670,
          y: 472,
          tx: 670,
          ty: 472,
          facing: "down",
          forcedFacing: null,
          currentDone: null,
          path: []
        });
        setLog("You step back through the utility door into the crew hallway.");
        updateUI();
      }
    }
  ]);
}

function inspectHallwayProp(id) {
  state.hallwayEffect = id;
  state.hallwayEffectUntil = performance.now() + (id === "cleaner" ? 900 : 650);
  if (id === "cleaner") {
    state.hallwayCleanerTargetX = state.hallwayCleanerX > 740 ? 710 : 780;
    playSfx("boop");
    return;
  }
  if (id === "mirror") state.player.facing = "up";
  if (id === "trash") playSfx("clank");
  else if (id === "paper" || id === "vase") playSfx("squish");
  else if (id === "mirror") playSfx("ding");
  else if (id === "hallVent") reactNope();
  else reactNope();
}

function beginHallwayPickup(id) {
  if (state.hallwayPickup) return;
  // Floor pickups beside bulky props should keep the side-facing pose chosen
  // by the approach path. This prevents the trash can or cleaner from hiding
  // the astronaut at the moment the interaction begins.
  if (id !== "rag" && id !== "ragShreds") state.player.facing = "down";
  state.player.path = [];
  state.player.currentDone = null;
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  state.hallwayPickup = {
    id,
    start: performance.now(),
    duration: 1050,
    from: id === "rag" ? { x: 214, y: 357 } : id === "ragShreds" ? { x: state.hallwayRagShredsX, y: 456 } : { x: 560, y: 284 }
  };
  playSfx(id === "rag" || id === "ragShreds" ? "squish" : "clank");
}

function pressDecoyButton() {
  if (state.decoyButtonBroken) {
    reactNope();
    setLog("The broken button hangs from two little wires.");
    return;
  }
  state.decoyButtonBroken = true;
  state.decoyButtonSparkUntil = performance.now() + 900;
  popComic("BOOP?", 733, 290, "#ff7abf");
  setTimeout(() => popComic("KZZT!", 742, 312, "#f2c45b"), 180);
  setLog("The button gives one heroic beep, snaps inward, and dies.");
}

function useLadder() {
  const floor = ladderFloorPoint();
  const top = ladderTopPoint();
  if (state.onLadder) {
    setPlayerPath([{
      x: floor.x,
      y: floor.y,
      facing: "up",
      done: () => {
        state.onLadder = false;
        state.hover = null;
      }
    }]);
    popComic("clank!", floor.x, floor.y - 25, "#f2c45b");
    setLog("You climb back down to the deck.");
    return;
  }
  state.onLadder = false;
  setPlayerPath([
    { x: floor.x, y: floor.y },
    {
      x: top.x,
      y: top.y,
      facing: "up",
      done: () => {
        state.onLadder = true;
        state.hover = null;
      }
    }
  ]);
  popComic("yoink!", top.x, top.y + 84, "#f2c45b");
  setLog("You walk to the ladder, then climb straight up under the leak.");
}

function pushCargoCart() {
  state.player.facing = state.player.x < state.cartX ? "right" : "left";
  state.cartLeft = !state.cartLeft;
  state.cartTargetX = state.cartLeft ? CART_LEFT_X : CART_RIGHT_X;
  state.cartWobbleUntil = performance.now() + 650;
  popComic("clank!", state.cartTargetX, 414, "#f2c45b");
  setLog("The cargo cart rattles along its track and stops with a hollow clank.");
}

function inspectAlienToy() {
  if (state.toyExamining) return;
  // Keep the pickup strictly arrival-driven even if another input path calls
  // the action directly. The plush must remain on the floor until the
  // astronaut has actually walked into reach.
  const toyHotspot = hotspotList().find(hotspot => hotspot.id === "alienToy");
  const approach = generatedApproachPoint(toyHotspot);
  if (Math.hypot(state.player.x - approach.x, state.player.y - approach.y) > 4) {
    movePlayerNear(toyHotspot, inspectAlienToy);
    return;
  }
  const now = performance.now();
  state.player.facing = state.player.x < 413 ? "right" : "left";
  state.player.path = [];
  state.player.currentDone = null;
  state.player.tx = state.player.x;
  state.player.ty = state.player.y;
  state.toyExamining = true;
  state.toyInspectStart = now;
  state.toyInspectUntil = now + 2300;
  state.hover = null;
  playSfx("squish");
  setTimeout(() => {
    if (state.toyExamining) playSfx("ding");
  }, 920);
}

function openLocker() {
  if (state.lockerOpen) {
    setLog(hasItem("sealant") ? "The locker is empty except for a warning label shaped like a screaming moon." : "The locker hangs open.");
    return;
  }
  state.lockerOpen = true;
  popComic("pop!", 236, 304, "#f2c45b");
  setLog("The emergency locker pops open with a wet metallic thunk. A sealant patch droops inside.");
  addItem("sealant");
}

function collectHelmet() {
  if (hasItem("helmet") || hasItem("patchedHelmet")) {
    setLog("You already salvaged the cracked helmet shell.");
    return;
  }
  if (state.ventSealed) {
    setLog("The patched helmet is already sealing the leak.");
    return;
  }
  addItem("helmet");
}

function inspectVent() {
  if (!state.onLadder) {
    const floor = ladderFloorPoint();
    reactNope();
    state.player.tx = floor.x;
    state.player.ty = floor.y;
    setLog("The pressure leak is too high to reach from the floor.");
    return;
  }
  if (useSelectedOn("vent")) return;
  setLog(state.ventSealed ? "The patched helmet holds. The airlock finally sounds like a room instead of a catastrophe." : "Air is venting through a torn intake. Something broad and sealed could plug it.");
}

function pullLever() {
  // Once the hatch has sealed, the lever toggles it open / closed (opening needs the crystal).
  if (state.pressureEqualized && (state.outerDoorClosed ? hasItem("powerCrystal") : true)) {
    const now = performance.now();
    if (now < (state.outerDoorBusyUntil || 0)) return;
    state.outerDoorBusyUntil = now + OUTER_HATCH_CLOSE_MS;
    clearTimeout(outerDoorOpenTimer);
    playSfx("whoosh");
    if (state.outerDoorClosed) {
      state.leverPulled = false;
      state.outerDoorOpenStart = now;
      outerDoorOpenTimer = setTimeout(() => {
        outerDoorOpenTimer = 0;
        state.outerDoorClosed = false;
        playSfx("clank");
        updateUI();
      }, OUTER_HATCH_CLOSE_MS);
    } else {
      state.leverPulled = true;
      state.outerDoorClosed = true;
      state.outerDoorOpenStart = 0;
      state.outerDoorCloseStart = now;
      outerDoorOpenTimer = setTimeout(() => {
        outerDoorOpenTimer = 0;
        playSfx("clank");
        updateUI();
      }, OUTER_HATCH_CLOSE_MS);
    }
    updateUI();
    return;
  }
  if (state.pressureEqualized || state.leverPulled) {
    reactNope();
    setLog("The pressure needle is steady. The lever refuses to do anything dramatic twice.");
    return;
  }
  if (!state.ventSealed) {
    reactNope();
    setLog("You pull the lever. The room screams louder. You shove it back before your boots leave the floor.");
    return;
  }
  state.leverPulled = true;
  state.outerDoorCloseStart = performance.now();
  playSfx("whoosh");
  clearTimeout(outerDoorCloseTimer);
  outerDoorCloseTimer = setTimeout(() => {
    outerDoorCloseTimer = 0;
    state.outerDoorClosed = true;
    state.pressureEqualized = true;
    state.tagAvailable = true;
    state.tagReleaseStart = performance.now();
    playSfx("clank");
    setTimeout(() => playSfx("pop"), 1080);
    setLog("The outer hatch seals. Pressure returns, and the maintenance drawer releases its tag.");
    updateUI();
  }, OUTER_HATCH_CLOSE_MS);
  setLog("The lever drops and the outer hatch begins to close.");
}

function inspectScanner() {
  if (useSelectedOn("scanner")) return;
  setLog(state.scannerSpoofed ? "The scanner glows green. It now believes you are a very tall maintenance bot." : "The scanner wants alien credentials. Or something that looks credential-ish.");
}

function openInnerDoor() {
  if (state.complete) {
    enterHallway();
    return;
  }
  if (!state.scannerSpoofed) {
    state.innerDoorRejectUntil = performance.now() + 420;
    reactNope();
    setLog("The inner hatch stays locked. A scanner beside it blinks in judgment.");
    return;
  }
  state.complete = true;
  state.innerDoorOpenStart = performance.now();
  playSfx("whoosh");
  setLog("The inner hatch exhales open. The ship accepts your lie and invites you deeper.");
  updateUI();
}

function updateUI() {
  ui.inventory.innerHTML = "";
  let selectedButton = null;
  if (!state.inventory.length) {
    const empty = document.createElement("p");
    empty.className = "s4-empty";
    empty.textContent = "No items yet.";
    ui.inventory.append(empty);
  }
  for (const id of state.inventory) {
    const button = document.createElement("button");
    button.type = "button";
    button.className = "s4-item";
    button.classList.toggle("is-selected", state.selected === id);
    if (state.selected === id) selectedButton = button;
    button.innerHTML = `<span class="s4-item-art"><img src="${items[id].sprite}?v=stage4-item-sprites-1" alt=""></span><strong>${items[id].name}</strong><small>${items[id].description}</small>`;
    button.addEventListener("click", () => {
      if (state.selected && state.selected !== id) {
        tryCombine(state.selected, id);
        return;
      }
      state.selected = state.selected === id ? null : id;
      setLog(state.selected ? `Selected ${items[id].name}. Click something in the airlock to use it.` : "Item put away.");
      updateUI();
    });
    ui.inventory.append(button);
  }
  if (selectedButton) requestAnimationFrame(() => selectedButton.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "center" }));
  ui.clear.hidden = !state.selected;
  const roomLevel = document.querySelector("#s4RoomLevel");
  const roomName = document.querySelector("#s4RoomName");
  if (roomLevel) roomLevel.textContent = state.room === "controlRoom" ? "Level 8" : state.room === "biomatter" ? "Level 7" : state.room === "breachedHallway" ? "Level 6" : state.room === "crawlspace" ? "Level 5" : state.room === "bathroom" ? "Level 4" : state.room === "utility" ? "Level 3" : state.room === "hallway" ? "Level 2" : "Level 1";
  if (roomName) roomName.textContent = state.room === "controlRoom" ? "Heart Chamber" : state.room === "biomatter" ? "Biomatter Samples" : state.room === "breachedHallway" ? "Breached Hallway" : state.room === "crawlspace" ? "Hidden Crawlspace" : state.room === "bathroom" ? "Alien Washroom" : state.room === "utility" ? "Utility Closet" : state.room === "hallway" ? "Crew Hallway" : "Breached Airlock";
  document.querySelector("#s4DebugAirlock")?.classList.toggle("is-active", state.room === "airlock");
  document.querySelector("#s4DebugHallway")?.classList.toggle("is-active", state.room === "hallway");
  document.querySelector("#s4DebugUtility")?.classList.toggle("is-active", state.room === "utility");
  document.querySelector("#s4DebugBathroom")?.classList.toggle("is-active", state.room === "bathroom");
  document.querySelector("#s4DebugCrawlspace")?.classList.toggle("is-active", state.room === "crawlspace");
  document.querySelector("#s4DebugBreachedHallway")?.classList.toggle("is-active", state.room === "breachedHallway");
  document.querySelector("#s4DebugBiomatter")?.classList.toggle("is-active", state.room === "biomatter");
  document.querySelector("#s4DebugControlRoom")?.classList.toggle("is-active", state.room === "controlRoom");
  canvas.setAttribute("aria-label", state.room === "controlRoom" ? "Alien ship control room and heart chamber" : state.room === "biomatter" ? "Alien biomatter sample room" : state.room === "breachedHallway" ? "Breached alien ship hallway" : state.room === "crawlspace" ? "Hidden alien maintenance crawlspace" : state.room === "bathroom" ? "Alien ship washroom" : state.room === "utility" ? "Alien ship utility closet" : state.room === "hallway" ? "Alien ship crew hallway" : "Alien airlock point and click puzzle");
  if (ui.steps) {
    ui.steps.innerHTML = "";
    for (const [label, done] of steps) {
      const li = document.createElement("li");
      li.className = done() ? "is-done" : "";
      li.textContent = label;
      ui.steps.append(li);
    }
  }
}

function getCanvasContentRect() {
  const box = canvas.getBoundingClientRect();
  const sourceRatio = canvas.width / canvas.height;
  const boxRatio = box.width / box.height;
  if (boxRatio > sourceRatio) {
    const height = box.height;
    const width = height * sourceRatio;
    return { left: box.left + (box.width - width) / 2, top: box.top, width, height, right: box.left + (box.width + width) / 2, bottom: box.bottom };
  }
  const width = box.width;
  const height = width / sourceRatio;
  return { left: box.left, top: box.top + (box.height - height) / 2, width, height, right: box.right, bottom: box.top + (box.height + height) / 2 };
}

function screenToCanvasPoint(x, y) {
  const r = getCanvasContentRect();
  return {
    x: (x - r.left) * canvas.width / r.width,
    y: (y - r.top) * canvas.height / r.height
  };
}

function ensureControllerCursor() {
  let cursor = document.querySelector("#s4GamepadCursor");
  if (!cursor) {
    cursor = document.createElement("div");
    cursor.id = "s4GamepadCursor";
    cursor.hidden = true;
    document.body.append(cursor);
  }
  return cursor;
}

function positionControllerCursor() {
  const cursor = ensureControllerCursor();
  cursor.hidden = !controller.connected;
  cursor.style.transform = `translate(${controller.screenX}px,${controller.screenY}px) translate(-50%,-50%)`;
  const r = getCanvasContentRect();
  controller.onCanvas = controller.screenX >= r.left && controller.screenX <= r.right && controller.screenY >= r.top && controller.screenY <= r.bottom;
  if (controller.onCanvas && !state.toyExamining && !state.bathroomJanitorWinkStart && !state.bathroomMopAction && !state.crawlspaceNotePickupStart && !state.crawlspaceNoteViewing && !state.crawlspaceNoteReturnStart && !state.crawlspaceMirrorPaperPickupStart && !state.crawlspaceMirrorPaperViewing && !state.crawlspaceMirrorPaperReturnStart && !state.crawlspacePipeButtonPressStart) {
    const p = screenToCanvasPoint(controller.screenX, controller.screenY);
    controller.x = p.x;
    controller.y = p.y;
    state.hover = hitTest(p) || null;
  } else {
    state.hover = null;
  }
}

function movePlayerToPoint(point) {
  // At the top of the ladder the astronaut is not on a walkable floor plane.
  // Empty-space clicks must never detach the character into midair.
  if (state.onLadder) {
    reactNope();
    return false;
  }
  if (!isGroundTile(point)) {
    reactNope();
    return false;
  }
  state.onLadder = false;
  state.player.path = [];
  state.player.currentDone = null;
  if (state.room === "breachedHallway") {
    // isGroundTile already validated this exact point against the intact
    // platform. Do not apply the airlock's 414-474 Y clamp here.
    if (routeAcrossBreachBridge(point)) return true;
    state.player.tx = point.x;
    state.player.ty = point.y;
  } else if (state.room === "hallway" || state.room === "bathroom" || state.room === "crawlspace") {
    state.player.tx = Math.max(42, Math.min(918, point.x));
    // Room 2 is intentionally a side-scrolling corridor. Free movement only
    // changes X; interaction paths may step slightly off this line.
    state.player.ty = state.room === "bathroom" ? Math.max(390, Math.min(555, point.y))
      : state.room === "crawlspace" ? CRAWLSPACE_WALK_Y
      : 472;
  } else if (state.room === "utility" || state.room === "biomatter" || state.room === "controlRoom") {
    if (routeAroundBiomatterCanister(point)) return true;
    state.player.tx = point.x;
    state.player.ty = point.y;
  } else {
    state.player.tx = Math.max(72, Math.min(890, point.x));
    state.player.ty = isGeneratedMode() ? Math.max(414, Math.min(474, point.y)) : Math.max(520, Math.min(570, point.y));
  }
  return true;
}

function setPlayerPath(points) {
  const [first, ...rest] = points;
  if (!first) return;
  state.player.path = rest;
  state.player.currentDone = first.done || null;
  state.player.forcedFacing = first.facing || null;
  state.player.tx = first.x;
  state.player.ty = first.y;
}

function activatePoint(point) {
  if (state.escapeEndingStart && performance.now() - state.escapeEndingStart > 6200) { window.location.href = "stage5.html"; return; }
  if (state.controlDeath || state.escapeEndingStart) return;
  if (closeCrawlspaceNote() || closeCrawlspaceMirrorPaper()) return;
  // The shrug is a complete player reaction, not an overlay on movement.
  // Ignore new destinations and interactions until its final frame finishes.
  if (playerIsReacting() || state.toyExamining || state.hallwayPickup || state.hallwayRopeTying || state.hallwayVentClimbing || state.utilityEntryAnimating || state.utilityAction || state.breachHeatAction || state.breachPipeFall || state.breachHop || state.biomatterHorror || state.bathroomSecretPanelStart || state.bathroomJanitorWinkStart || state.bathroomMopAction || state.bathroomToiletAction || state.crawlspaceNotePickupStart || state.crawlspaceNoteReturnStart || state.crawlspaceMirrorPaperPickupStart || state.crawlspaceMirrorPaperReturnStart || state.crawlspacePipeButtonPressStart) return;
  const hit = hitTest(point);
  if (state.keypadOpen || state.tunerOpen) {
    if (hit) hit.action();
    return;
  }
  if (state.onLadder && (!hit || (hit.id !== "vent" && hit.id !== "ladder"))) {
    reactNope();
    return;
  }
  if (!hit) {
    if (state.room === "hallway" && state.selected === "dirt" && isGroundTile(point)) {
      const dirtX = point.x;
      if (movePlayerToPoint(point)) state.player.currentDone = () => spillHallwayDirt(dirtX);
      return;
    }
    if (movePlayerToPoint(point)) setLog(state.selected ? `${items[state.selected].name} stays ready while you move.` : "You move across the alien deck.");
    return;
  }
  movePlayerNear(hit, hit.action);
}

function autoScrollViewport(dt) {
  const margin = 74;
  const scroller = document.scrollingElement || document.documentElement;
  let dx = 0;
  let dy = 0;
  if (controller.screenX < margin) dx = -1;
  else if (controller.screenX > innerWidth - margin) dx = 1;
  if (controller.screenY < margin) dy = -1;
  else if (controller.screenY > innerHeight - margin) dy = 1;
  if (!dx && !dy) return;
  const speed = 520 * dt;
  const maxLeft = scroller.scrollWidth - scroller.clientWidth;
  const maxTop = scroller.scrollHeight - scroller.clientHeight;
  scroller.scrollLeft = Math.max(0, Math.min(maxLeft, scroller.scrollLeft + dx * speed));
  scroller.scrollTop = Math.max(0, Math.min(maxTop, scroller.scrollTop + dy * speed));
}

function cycleInventory(delta) {
  if (state.hallwayRopeTying || state.hallwayVentClimbing || state.utilityEntryAnimating || state.utilityAction || state.breachHeatAction || state.breachPipeFall || state.breachHop || state.biomatterHorror || state.bathroomSecretPanelStart || state.bathroomJanitorWinkStart || state.bathroomMopAction || state.bathroomToiletAction || state.crawlspaceNotePickupStart || state.crawlspaceNoteViewing || state.crawlspaceNoteReturnStart || state.crawlspaceMirrorPaperPickupStart || state.crawlspaceMirrorPaperViewing || state.crawlspaceMirrorPaperReturnStart || state.crawlspacePipeButtonPressStart) return;
  if (!state.inventory.length) {
    reactNope();
    setLog("No inventory items yet.");
    return;
  }
  controller.inventoryIndex = (controller.inventoryIndex + delta + state.inventory.length) % state.inventory.length;
  state.selected = state.inventory[controller.inventoryIndex];
  setLog(`Selected ${items[state.selected].name}. Move the cursor to something in the airlock and press A.`);
  updateUI();
}

function controllerClick() {
  const target = document.elementFromPoint(controller.screenX, controller.screenY);
  const button = target?.closest?.(".s4-item, #s4ClearItem, .s4-debug-button, .stage-link");
  if (button && !button.disabled && !button.hidden) {
    button.click();
    return;
  }
  if (controller.onCanvas) activatePoint(screenToCanvasPoint(controller.screenX, controller.screenY));
}

function updateController(dt) {
  const pad = Array.from(navigator.getGamepads?.() || []).find(Boolean);
  if (!pad) {
    if (controller.connected && ui.controller) ui.controller.textContent = "Controller disconnected";
    controller.connected = false;
    controller.buttons = [];
    const cursor = document.querySelector("#s4GamepadCursor");
    if (cursor) cursor.hidden = true;
    return;
  }

  if (!controller.connected && ui.controller) ui.controller.textContent = `${pad.id} connected · A clicks · B puts item away · LB/RB cycles items`;
  controller.connected = true;
  if (!controller.initialized) {
    const r = getCanvasContentRect();
    controller.screenX = r.left + r.width / 2;
    controller.screenY = r.top + r.height / 2;
    controller.initialized = true;
  }

  const held = i => Boolean(pad.buttons[i]?.pressed || pad.buttons[i]?.value > .55);
  const edge = i => held(i) && !controller.buttons[i];
  const rawX = Math.abs(pad.axes[0] || 0) > .18 ? pad.axes[0] : 0;
  const rawY = Math.abs(pad.axes[1] || 0) > .18 ? pad.axes[1] : 0;
  const dpadX = held(15) ? 1 : held(14) ? -1 : 0;
  const dpadY = held(13) ? 1 : held(12) ? -1 : 0;
  const ax = rawX || dpadX * .7;
  const ay = rawY || dpadY * .7;
  controller.screenX = Math.max(4, Math.min(innerWidth - 18, controller.screenX + ax * 440 * dt));
  controller.screenY = Math.max(4, Math.min(innerHeight - 18, controller.screenY + ay * 440 * dt));
  autoScrollViewport(dt);
  positionControllerCursor();

  if (edge(0)) controllerClick();
  if (edge(1)) {
    if (closeCrawlspaceNote() || closeCrawlspaceMirrorPaper()) {
      controller.buttons = pad.buttons.map((_, i) => held(i));
      return;
    }
    if (state.tunerOpen) {
      closeTuner();
      controller.buttons = pad.buttons.map((_, i) => held(i));
      return;
    }
    if (state.keypadOpen) {
      closeHallwayKeypad();
      controller.buttons = pad.buttons.map((_, i) => held(i));
      return;
    }
    state.selected = null;
    setLog("Item put away.");
    updateUI();
  }
  if (edge(4)) cycleInventory(-1);
  if (edge(5)) cycleInventory(1);
  controller.buttons = pad.buttons.map((_, i) => held(i));
}

function canvasPoint(event) {
  return screenToCanvasPoint(event.clientX, event.clientY);
}

function isGeneratedMode() {
  return generatedArt.usePreview && generatedArt.backgroundReady;
}

function ladderFloorPoint() {
  return isGeneratedMode() ? { x: 490, y: 452 } : { x: 568, y: 535 };
}

function ladderTopPoint() {
  // Place the helmet just beneath the ceiling opening while leaving the hole
  // itself visible above the character.
  return isGeneratedMode() ? { x: 490, y: 292 } : { x: 568, y: 282 };
}

function pointInEllipse(point, cx, cy, rx, ry, rotation = 0) {
  const cos = Math.cos(-rotation);
  const sin = Math.sin(-rotation);
  const dx = point.x - cx;
  const dy = point.y - cy;
  const x = dx * cos - dy * sin;
  const y = dx * sin + dy * cos;
  return (x * x) / (rx * rx) + (y * y) / (ry * ry) <= 1;
}

function pointInRect(point, x, y, w, h) {
  return point.x >= x && point.x <= x + w && point.y >= y && point.y <= y + h;
}

function pointNearSegment(point, x1, y1, x2, y2, radius) {
  const dx = x2 - x1;
  const dy = y2 - y1;
  const lenSq = dx * dx + dy * dy || 1;
  const t = Math.max(0, Math.min(1, ((point.x - x1) * dx + (point.y - y1) * dy) / lenSq));
  const x = x1 + dx * t;
  const y = y1 + dy * t;
  return Math.hypot(point.x - x, point.y - y) <= radius;
}

function pointInPolygon(point, vertices) {
  let inside = false;
  for (let i = 0, j = vertices.length - 1; i < vertices.length; j = i++) {
    const xi = vertices[i][0], yi = vertices[i][1];
    const xj = vertices[j][0], yj = vertices[j][1];
    const intersect = ((yi > point.y) !== (yj > point.y)) &&
      (point.x < (xj - xi) * (point.y - yi) / ((yj - yi) || .0001) + xi);
    if (intersect) inside = !inside;
  }
  return inside;
}

function pointNearPolyline(point, vertices, radius) {
  for (let i = 0; i < vertices.length - 1; i++) {
    if (pointNearSegment(point, vertices[i][0], vertices[i][1], vertices[i + 1][0], vertices[i + 1][1], radius)) return true;
  }
  return false;
}

// Painted-frame outlines for the three hallway doors that have no sprite of
// their own. Kept as named constants because the hit test and the highlight
// have to stay on exactly the same path.
const HALL_RIGHT_DOOR_OUTLINE = [
  [889,154],[897,151],[905,151],[914,152],[922,155],[930,159],
  [937,164],[942,170],[947,176],[951,183],[954,192],[956,201],
  [957,211],[958,220],[958,230],[958,240],[958,250],[958,259],
  [958,269],[958,279],[957,288],[956,297],[956,307],[956,316],
  [957,325],[957,334],[957,344],[957,353],[957,362],[957,371],
  [957,381],[956,391],[955,401],[952,410],[948,417],[943,424],
  [937,430],[930,436],[922,441],[914,444],[905,446],[896,446],
  [888,443],[880,438],[874,430],[869,421],[864,412],[860,404],
